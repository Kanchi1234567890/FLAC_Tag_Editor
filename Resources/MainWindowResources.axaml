<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MainWindow -->
    <x:String x:Key="MainWindowTitle">FLAC Tag Editor</x:String>

    <!-- MainWindow / Form -->
    <x:Boolean x:Key="MainWindowExtendClientAreaToDecorationsHint">False</x:Boolean>
    <WindowDecorations x:Key="MainWindowDecorations">Full</WindowDecorations>

    <!-- MainWindow / Size -->
    <x:Double x:Key="MainWindowWidth">1280</x:Double>
    <x:Double x:Key="MainWindowHeight">760</x:Double>
    <x:Double x:Key="MainWindowMinWidth">900</x:Double>
    <x:Double x:Key="MainWindowMinHeight">540</x:Double>
    <x:Boolean x:Key="MainWindowCanResize">True</x:Boolean>

    <!-- MainWindow / Location -->
    <WindowStartupLocation x:Key="MainWindowStartupLocation">CenterScreen</WindowStartupLocation>
    <x:Boolean x:Key="MainWindowTopmost">False</x:Boolean>

    <!-- MainWindow / Color Palette (Dark Base) -->
    <SolidColorBrush x:Key="MainWindowBackgroundColor" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="MainWindowBorderColor" Color="#FF333333"/>
    <SolidColorBrush x:Key="ToolbarBackgroundColor" Color="#FF252526"/>
    <SolidColorBrush x:Key="DetailPaneBackgroundColor" Color="#FF232325"/>
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#FF2B2B2E"/>
    <SolidColorBrush x:Key="StatusBarBackgroundColor" Color="#FF18181A"/>
    <SolidColorBrush x:Key="SplitterColor" Color="#FF333337"/>
    <SolidColorBrush x:Key="ReadOnlyFieldBackgroundColor" Color="#FF1B1B1D"/>
    <SolidColorBrush x:Key="ReadOnlyFieldBorderColor" Color="#FF38383D"/>
    <SolidColorBrush x:Key="EditableFieldBackgroundColor" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="EditableFieldBorderColor" Color="#FF4A4A52"/>
    <SolidColorBrush x:Key="TextColor" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#FFA6A6AE"/>
    <SolidColorBrush x:Key="SectionHeaderColor" Color="#FF78B7FF"/>
    <SolidColorBrush x:Key="DirtyIndicatorColor" Color="#FFFFC857"/>
    <SolidColorBrush x:Key="ArtworkIndicatorColor" Color="#FF64B5F6"/>
    <SolidColorBrush x:Key="DirtyBannerBackgroundColor" Color="#33FFC857"/>
    <SolidColorBrush x:Key="DirtyBannerBorderColor" Color="#88FFC857"/>
    <SolidColorBrush x:Key="ErrorTextColor" Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="ErrorBorderColor" Color="#FFE05252"/>
    <SolidColorBrush x:Key="DropTargetBorderColor" Color="#FF78B7FF"/>
    <SolidColorBrush x:Key="DropTargetOverlayBackgroundColor" Color="#CC1A2B3D"/>
    <SolidColorBrush x:Key="SearchBarBackgroundColor" Color="#FF242428"/>
    <SolidColorBrush x:Key="SearchPreviewBackgroundColor" Color="#FF2A2D34"/>
    <SolidColorBrush x:Key="SearchPreviewHeaderBackgroundColor" Color="#FF323640"/>
    <SolidColorBrush x:Key="SearchPreviewColumnHeaderBackgroundColor" Color="#FF2F333C"/>
    <SolidColorBrush x:Key="SearchPreviewBorderColor" Color="#FF454B58"/>
    <SolidColorBrush x:Key="SearchPreviewGridLinesColor" Color="#FF3A3F4B"/>
    <SolidColorBrush x:Key="PreviewWarningTextColor" Color="#FFFFB74D"/>
    <SolidColorBrush x:Key="PreviewReadyTextColor" Color="#FF81C784"/>
    <SolidColorBrush x:Key="SearchOptionCheckedBackgroundColor" Color="#FF2B4C7E"/>
    <SolidColorBrush x:Key="SearchOptionCheckedBorderColor" Color="#FF78B7FF"/>
    <SolidColorBrush x:Key="InlineClearButtonHoverBackgroundColor" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBadgeBackgroundColor" Color="#3378B7FF"/>
    <SolidColorBrush x:Key="SelectionBadgeBorderColor" Color="#8878B7FF"/>
    <SolidColorBrush x:Key="ArtworkThumbSelectedBorderColor" Color="#FF78B7FF"/>
    <SolidColorBrush x:Key="ArtworkThumbSelectedBackgroundColor" Color="#3378B7FF"/>
    <SolidColorBrush x:Key="ArtworkThumbHoverBackgroundColor" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="SyncButtonBackgroundColor" Color="#FF2B4C7E"/>
    <SolidColorBrush x:Key="SyncButtonBorderColor" Color="#FF78B7FF"/>

    <!-- Layout Sizes -->
    <GridLength x:Key="DetailPaneInitialWidth">380</GridLength>
    <x:Double x:Key="DetailPaneMinWidth">300</x:Double>
    <x:Double x:Key="DetailPaneMaxWidth">640</x:Double>
    <x:Double x:Key="ListPaneMinWidth">360</x:Double>
    <x:Double x:Key="SplitterWidth">4</x:Double>
    <x:Double x:Key="ToolbarSeparatorWidth">1</x:Double>
    <x:Double x:Key="ToolbarSeparatorHeight">20</x:Double>
    <x:Double x:Key="ArtworkContainerSize">200</x:Double>
    <x:Double x:Key="ArtworkThumbItemWidth">60</x:Double>
    <x:Double x:Key="ArtworkThumbImageSize">44</x:Double>
    <x:Double x:Key="ArtworkThumbListHeight">82</x:Double>
    <x:Double x:Key="ArtworkNavButtonWidth">26</x:Double>
    <x:Double x:Key="ArtworkNavButtonMinHeight">22</x:Double>
    <x:Double x:Key="LoadingProgressWidth">120</x:Double>
    <x:Double x:Key="LoadingProgressHeight">4</x:Double>
    <x:Double x:Key="CommentFieldMinHeight">64</x:Double>
    <x:Double x:Key="CompactButtonMinHeight">24</x:Double>
    <x:Double x:Key="RemoveTagButtonWidth">28</x:Double>
    <x:Double x:Key="SearchTargetComboWidth">144</x:Double>
    <x:Double x:Key="SearchInputMinWidth">100</x:Double>
    <x:Double x:Key="SearchNavButtonWidth">28</x:Double>
    <x:Double x:Key="SearchCloseButtonWidth">28</x:Double>
    <x:Double x:Key="InlineClearButtonSize">20</x:Double>
    <x:Double x:Key="SearchPreviewDefaultHeight">280</x:Double>
    <x:Double x:Key="SearchPreviewMinHeight">100</x:Double>
    <x:Double x:Key="TrackListMinHeight">120</x:Double>
    <x:Double x:Key="ColPreviewTrackMinWidth">150</x:Double>
    <x:Double x:Key="ColPreviewFieldMinWidth">96</x:Double>
    <x:Double x:Key="ColPreviewValueMinWidth">200</x:Double>
    <x:Double x:Key="ColPreviewStatusMinWidth">120</x:Double>
    <x:Double x:Key="UnsavedDialogWidth">460</x:Double>
    <x:Double x:Key="UnsavedDialogSectionSpacing">12</x:Double>
    <x:Double x:Key="UnsavedDialogLineHeight">20</x:Double>
    <x:Double x:Key="ColumnChooserFlyoutMinWidth">200</x:Double>
    <x:Double x:Key="ColumnChooserDividerHeight">1</x:Double>
    <x:Double x:Key="ColumnChooserItemSpacing">4</x:Double>

    <!-- DataGrid Column Widths -->
    <DataGridLength x:Key="ColDirtyWidth">28</DataGridLength>
    <DataGridLength x:Key="ColArtworkWidth">64</DataGridLength>
    <DataGridLength x:Key="ColTrackWidth">72</DataGridLength>
    <DataGridLength x:Key="ColTitleWidth">220</DataGridLength>
    <DataGridLength x:Key="ColArtistWidth">180</DataGridLength>
    <DataGridLength x:Key="ColAlbumWidth">200</DataGridLength>
    <DataGridLength x:Key="ColAlbumArtistWidth">160</DataGridLength>
    <DataGridLength x:Key="ColYearWidth">64</DataGridLength>
    <DataGridLength x:Key="ColDurationWidth">76</DataGridLength>
    <DataGridLength x:Key="ColFileNameWidth">220</DataGridLength>
    <DataGridLength x:Key="ColDiscWidth">72</DataGridLength>
    <DataGridLength x:Key="ColGenreWidth">140</DataGridLength>
    <DataGridLength x:Key="ColCommentWidth">220</DataGridLength>
    <DataGridLength x:Key="ColPreviewTrackWidth">Auto</DataGridLength>
    <DataGridLength x:Key="ColPreviewFieldWidth">Auto</DataGridLength>
    <DataGridLength x:Key="ColPreviewBeforeWidth">Auto</DataGridLength>
    <DataGridLength x:Key="ColPreviewAfterWidth">Auto</DataGridLength>
    <DataGridLength x:Key="ColPreviewStatusWidth">Auto</DataGridLength>

    <!-- Spacing / Borders / Typography -->
    <Thickness x:Key="ToolbarPadding">12,8</Thickness>
    <Thickness x:Key="ToolbarSeparatorMargin">4,0</Thickness>
    <Thickness x:Key="StatusBarPadding">12,6</Thickness>
    <Thickness x:Key="DetailPanePadding">16</Thickness>
    <Thickness x:Key="DetailBannerAreaPadding">16,8</Thickness>
    <Thickness x:Key="HorizontalTextMargin">16,0</Thickness>
    <Thickness x:Key="SectionMargin">0,14,0,6</Thickness>
    <Thickness x:Key="FieldLabelMargin">0,6,0,2</Thickness>
    <Thickness x:Key="CounterSeparatorMargin">4,0</Thickness>
    <Thickness x:Key="DirtyBannerPadding">10,6</Thickness>
    <Thickness x:Key="CustomTagCardPadding">8</Thickness>
    <Thickness x:Key="CustomTagCardMargin">0,0,0,8</Thickness>
    <Thickness x:Key="CompactButtonPadding">8,2</Thickness>
    <Thickness x:Key="ArtworkActionButtonPadding">10,4</Thickness>
    <Thickness x:Key="ArtworkNavButtonPadding">4,1</Thickness>
    <Thickness x:Key="ArtworkHintPadding">12</Thickness>
    <Thickness x:Key="ArtworkThumbListPadding">4</Thickness>
    <Thickness x:Key="ArtworkThumbItemPadding">4</Thickness>
    <Thickness x:Key="ArtworkThumbItemMargin">0,0,4,0</Thickness>
    <Thickness x:Key="ArtworkMetadataMargin">0,2,0,0</Thickness>
    <Thickness x:Key="ArtworkCellMargin">12,0,0,0</Thickness>
    <Thickness x:Key="SelectionBadgePadding">10,4</Thickness>
    <Thickness x:Key="SearchBarPadding">10,8</Thickness>
    <Thickness x:Key="SearchOptionPadding">8,3</Thickness>
    <Thickness x:Key="InlineClearButtonMargin">0,0,4,0</Thickness>
    <Thickness x:Key="InlineClearButtonPadding">0</Thickness>
    <Thickness x:Key="SearchPreviewHeaderPadding">10,5</Thickness>
    <Thickness x:Key="SearchPreviewEmptyPadding">10,12</Thickness>
    <Thickness x:Key="UnsavedDialogPadding">20</Thickness>
    <Thickness x:Key="UnsavedDialogButtonsMargin">0,8,0,0</Thickness>
    <Thickness x:Key="UnsavedDialogButtonPadding">14,6</Thickness>
    <Thickness x:Key="ColumnChooserFlyoutPadding">4</Thickness>
    <Thickness x:Key="ColumnChooserHeaderMargin">0,0,0,4</Thickness>
    <Thickness x:Key="ColumnChooserDividerMargin">0,6,0,6</Thickness>
    <Thickness x:Key="BottomBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="TopBorderThickness">0,1,0,0</Thickness>
    <Thickness x:Key="SearchPreviewBorderThickness">0,1,0,1</Thickness>
    <Thickness x:Key="ThinBorderThickness">1</Thickness>
    <Thickness x:Key="DropHighlightBorderThickness">2</Thickness>
    <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>
    <x:Double x:Key="ToolbarSpacing">8</x:Double>
    <x:Double x:Key="StatusRightSpacing">16</x:Double>
    <x:Double x:Key="DetailItemSpacing">8</x:Double>
    <x:Double x:Key="SmallItemSpacing">6</x:Double>
    <x:Double x:Key="ArtworkThumbContentSpacing">2</x:Double>
    <x:Double x:Key="SectionHeaderFontSize">13</x:Double>
    <x:Double x:Key="LabelFontSize">11</x:Double>
    <x:Double x:Key="SmallLabelFontSize">10</x:Double>
    <x:Double x:Key="BodyFontSize">12</x:Double>
    <x:Double x:Key="StatusFontSize">12</x:Double>
    <x:Double x:Key="PlaceholderFontSize">14</x:Double>

    <!-- UI Labels -->
    <x:String x:Key="OpenFolderButtonText">フォルダを開く</x:String>
    <x:String x:Key="OpenFilesButtonText">ファイルを開く</x:String>
    <x:String x:Key="OpenFolderToolTip">フォルダ内のFLACファイルを一覧に読み込みます（既存の一覧を置き換え・▼から追加読み込み可能）</x:String>
    <x:String x:Key="OpenFilesToolTip">選択したFLACファイルを一覧に読み込みます（既存の一覧を置き換え・▼から追加読み込み可能）</x:String>
    <x:String x:Key="OpenFolderReplaceMenuText">フォルダを開く（置き換え）</x:String>
    <x:String x:Key="AppendFolderMenuText">フォルダを追加読み込み...</x:String>
    <x:String x:Key="OpenFilesReplaceMenuText">ファイルを開く（置き換え）</x:String>
    <x:String x:Key="AppendFilesMenuText">ファイルを追加読み込み...</x:String>
    <x:String x:Key="ClearTrackListButtonText">一覧をクリア</x:String>
    <x:String x:Key="ClearTrackListToolTip">読み込まれているトラック一覧をすべてクリアします</x:String>
    <x:String x:Key="ClearTrackListContextMenuText">一覧をクリア</x:String>
    <x:String x:Key="ColArtworkHeaderText">Art</x:String>
    <x:String x:Key="SaveSelectedButtonText">保存</x:String>
    <x:String x:Key="SaveAllButtonText">すべて保存</x:String>
    <x:String x:Key="RevertSelectedButtonText">変更を破棄</x:String>
    <x:String x:Key="RevertAllButtonText">すべて破棄</x:String>
    <x:String x:Key="PasteTsvButtonText">貼り付け</x:String>
    <x:String x:Key="PasteTsvContextMenuText">クリップボードから貼り付け (Ctrl+V)</x:String>
    <x:String x:Key="SearchReplaceButtonText">検索・置換</x:String>
    <x:String x:Key="ColumnsButtonText">表示列</x:String>
    <x:String x:Key="ColumnsButtonToolTip">一覧に表示する列の切り替え・並び順と列幅のリセット（settings.toml に自動保存）</x:String>
    <x:String x:Key="ColumnChooserTitleText">表示する列</x:String>
    <x:String x:Key="ResetColumnsButtonText">既定に戻す</x:String>
    <x:String x:Key="ResetColumnsToolTip">列の表示・並び順・幅を既定の状態に戻します</x:String>
    <x:String x:Key="ColumnsContextMenuText">表示列</x:String>
    <x:String x:Key="AddArtworkContextMenuText">アートワークを追加...</x:String>
    <x:String x:Key="SyncArtworksContextMenuText">選択中へアートワーク構成を同期</x:String>
    <x:String x:Key="ClearAllArtworksContextMenuText">アートワークをすべて削除</x:String>
    <x:String x:Key="SaveSelectedContextMenuText">選択トラックを保存 (Ctrl+S)</x:String>
    <x:String x:Key="RevertSelectedContextMenuText">選択トラックの変更を破棄</x:String>
    <x:String x:Key="SaveSelectedToolTip">選択中のトラックを保存（複数選択時は一括保存） (Ctrl+S)</x:String>
    <x:String x:Key="SaveAllToolTip">変更のあるすべてのトラックを保存 (Ctrl+Shift+S)</x:String>
    <x:String x:Key="RevertSelectedToolTip">選択中のトラックの未保存変更を元に戻す（複数選択時は一括破棄）</x:String>
    <x:String x:Key="RevertAllToolTip">すべての未保存変更を元に戻す</x:String>
    <x:String x:Key="PasteTsvToolTip">クリップボードのタブ区切りテキストを選択セルから一括貼り付け (Ctrl+V)</x:String>
    <x:String x:Key="SearchReplaceToolTip">ファイル名・タグの検索および一括置換バーを表示 (Ctrl+F / Ctrl+H)</x:String>
    <x:String x:Key="SearchInputPlaceholder">検索文字列または正規表現...</x:String>
    <x:String x:Key="ReplaceInputPlaceholder">置換後の文字列（正規表現時は $1 等が利用可能）</x:String>
    <x:String x:Key="SearchToggleReplaceExpandText">置換</x:String>
    <x:String x:Key="SearchToggleReplaceToolTip">置換入力欄の表示を切り替え</x:String>
    <x:String x:Key="SearchTargetComboToolTip">検索・置換の対象フィールドを選択</x:String>
    <x:String x:Key="SearchRegexButtonText">.*</x:String>
    <x:String x:Key="SearchRegexToolTip">正規表現を使用</x:String>
    <x:String x:Key="SearchCaseButtonText">Aa</x:String>
    <x:String x:Key="SearchCaseToolTip">大文字・小文字を区別</x:String>
    <x:String x:Key="SearchFilterButtonText">絞込</x:String>
    <x:String x:Key="SearchFilterToolTip">一致するトラックのみ一覧に表示</x:String>
    <x:String x:Key="SearchPreviousButtonText">↑</x:String>
    <x:String x:Key="SearchPreviousToolTip">前の一致トラックへ移動 (Shift+Enter)</x:String>
    <x:String x:Key="SearchNextButtonText">↓</x:String>
    <x:String x:Key="SearchNextToolTip">次の一致トラックへ移動 (Enter)</x:String>
    <x:String x:Key="SearchCloseButtonText">×</x:String>
    <x:String x:Key="SearchCloseToolTip">検索・置換バーを閉じる (Esc)</x:String>
    <x:String x:Key="ClearSearchTextButtonText">×</x:String>
    <x:String x:Key="ClearSearchPatternToolTip">検索文字列をクリア</x:String>
    <x:String x:Key="ClearReplacementTextToolTip">置換後の文字列をクリア</x:String>
    <x:String x:Key="SearchPreserveExtensionText">拡張子保護 (.flac)</x:String>
    <x:String x:Key="SearchPreserveExtensionToolTip">ファイル名置換時に .flac 拡張子を変更対象から除外</x:String>
    <x:String x:Key="SearchPreviewToggleText">プレビュー</x:String>
    <x:String x:Key="SearchPreviewToggleToolTip">置換前→置換後の一覧プレビューを表示・非表示</x:String>
    <x:String x:Key="SearchReplaceSelectedText">選択を置換</x:String>
    <x:String x:Key="SearchReplaceSelectedToolTip">現在選択中のトラックのみ置換（未保存状態へ反映）</x:String>
    <x:String x:Key="SearchReplaceAllText">すべて置換</x:String>
    <x:String x:Key="SearchReplaceAllToolTip">一致するすべてのトラックを一括置換（未保存状態へ反映）</x:String>
    <x:String x:Key="SearchPreviewEmptyText">現在の条件で変更が生じる項目はありません</x:String>
    <x:String x:Key="SearchPreviewHintText">行をクリックすると該当トラックを選択します</x:String>
    <x:String x:Key="SearchPreviewSplitterToolTip">上下にドラッグしてプレビュー欄の高さを調整</x:String>
    <x:String x:Key="FilterEmptyPlaceholderText">検索条件に一致するトラックがありません</x:String>
    <x:String x:Key="AddArtworkButtonText">+ 追加...</x:String>
    <x:String x:Key="ReplaceArtworkButtonText">差し替え...</x:String>
    <x:String x:Key="RemoveSelectedArtworkButtonText">削除</x:String>
    <x:String x:Key="ClearAllArtworksButtonText">全削除</x:String>
    <x:String x:Key="AddArtworkToolTip">ローカル画像ファイルからアートワークを末尾に追加（複数ファイル選択・複数トラック一括追加対応・JPEG/PNG以外も自動変換）</x:String>
    <x:String x:Key="ReplaceArtworkToolTip">現在表示中のアートワーク画像を差し替え（種別・説明は維持／単一選択時のみ）</x:String>
    <x:String x:Key="RemoveSelectedArtworkToolTip">現在表示中のアートワークを 1 枚削除（単一選択時のみ）</x:String>
    <x:String x:Key="ClearAllArtworksToolTip">選択中トラックのアートワークをすべて削除（複数選択時は一括全削除）</x:String>
    <x:String x:Key="SyncArtworksToolTip">現在表示中のトラックのアートワーク構成（枚数・順序・種別・説明・画像）を他の選択中トラックへ一括同期</x:String>
    <x:String x:Key="ArtworkPrevButtonText">◀</x:String>
    <x:String x:Key="ArtworkNextButtonText">▶</x:String>
    <x:String x:Key="ArtworkPrevToolTip">前のアートワークを表示</x:String>
    <x:String x:Key="ArtworkNextToolTip">次のアートワークを表示</x:String>
    <x:String x:Key="ArtworkOrderLabelText">順序:</x:String>
    <x:String x:Key="ArtworkMoveLeftButtonText">←</x:String>
    <x:String x:Key="ArtworkMoveRightButtonText">→</x:String>
    <x:String x:Key="ArtworkMoveLeftToolTip">選択中アートワークの並び順を前へ移動（単一選択時のみ）</x:String>
    <x:String x:Key="ArtworkMoveRightToolTip">選択中アートワークの並び順を後ろへ移動（単一選択時のみ）</x:String>
    <x:String x:Key="ArtworkTypeLabelText">種別</x:String>
    <x:String x:Key="ArtworkDescriptionLabelText">説明</x:String>
    <x:String x:Key="ArtworkDescriptionPlaceholder">説明（任意・例: ブックレット 1/4）</x:String>
    <x:String x:Key="ArtworkMultiSelectReadOnlyHintText">※ 個別スロットの差し替え・種別・説明・並び替えは単一選択時に編集できます</x:String>
    <x:String x:Key="AddCustomTagButtonText">+ 追加</x:String>
    <x:String x:Key="RemoveCustomTagButtonText">×</x:String>
    <x:String x:Key="RemoveCustomTagToolTip">この独自タグを削除</x:String>
    <x:String x:Key="UnsavedTrackBannerText">● 未保存の変更があります</x:String>
    <x:String x:Key="EmptyListPlaceholderText">「フォルダを開く」または「ファイルを開く」からFLACファイルを読み込んでください</x:String>
    <x:String x:Key="NoSelectionPlaceholderText">左の一覧からトラックを選択すると詳細タグが表示されます</x:String>
    <x:String x:Key="NoArtworkPlaceholderText">No Artwork&#x0a;（画像ファイル / Web画像をドロップして追加）</x:String>
    <x:String x:Key="NoCustomTagsPlaceholderText">独自タグはありません（「+ 追加」から追加できます）</x:String>
    <x:String x:Key="CounterSeparatorText">/</x:String>
    <x:String x:Key="CounterNumberPlaceholder">番号</x:String>
    <x:String x:Key="CounterTotalPlaceholder">総数</x:String>
    <x:String x:Key="YearPlaceholder">YYYY</x:String>
    <x:String x:Key="CustomTagKeyPlaceholder">キー (例: LABEL)</x:String>
    <x:String x:Key="CustomTagValuePlaceholder">値</x:String>

</ResourceDictionary>
