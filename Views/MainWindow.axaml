<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:FLAC_Tag_Editor.Models"
        xmlns:vm="using:FLAC_Tag_Editor.ViewModels"
        xmlns:views="using:FLAC_Tag_Editor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Name="RootWindow"
        x:Class="FLAC_Tag_Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{DynamicResource MainWindowTitle}"
        Width="{DynamicResource MainWindowWidth}"
        Height="{DynamicResource MainWindowHeight}"
        MinWidth="{DynamicResource MainWindowMinWidth}"
        MinHeight="{DynamicResource MainWindowMinHeight}"
        CanResize="{DynamicResource MainWindowCanResize}"
        Background="{DynamicResource MainWindowBackgroundColor}"
        WindowDecorations="{DynamicResource MainWindowDecorations}"
        WindowStartupLocation="{DynamicResource MainWindowStartupLocation}"
        BorderBrush="{DynamicResource MainWindowBorderColor}"
        Topmost="{DynamicResource MainWindowTopmost}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding SearchReplace.OpenFindCommand}"/>
        <KeyBinding Gesture="Ctrl+H" Command="{Binding SearchReplace.OpenReplaceCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Resources/MainWindowResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground" Value="{DynamicResource SectionHeaderColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="{DynamicResource SectionMargin}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="Margin" Value="{DynamicResource FieldLabelMargin}"/>
        </Style>
        <Style Selector="TextBox.editable-field">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource EditableFieldBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EditableFieldBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
        </Style>
        <Style Selector="TextBox.editable-field.error">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderColor}"/>
        </Style>
        <Style Selector="TextBox.readonly-field">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource ReadOnlyFieldBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReadOnlyFieldBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
        </Style>
        <Style Selector="TextBox.readonly-field.error">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderColor}"/>
        </Style>
        <Style Selector="ToggleButton.search-option">
            <Setter Property="Padding" Value="{DynamicResource SearchOptionPadding}"/>
            <Setter Property="MinHeight" Value="{DynamicResource CompactButtonMinHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.search-option:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SearchOptionCheckedBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchOptionCheckedBorderColor}"/>
        </Style>
        <Style Selector="TextBlock.preview-status">
            <Setter Property="Foreground" Value="{DynamicResource PreviewReadyTextColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.preview-status.warning">
            <Setter Property="Foreground" Value="{DynamicResource PreviewWarningTextColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="DataGrid.search-preview-grid DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SearchPreviewColumnHeaderBackgroundColor}"/>
        </Style>
        <Style Selector="Border.dirty-banner">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.dirty-banner.visible">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.artwork-drop-target">
            <Setter Property="BorderBrush" Value="{DynamicResource MainWindowBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
        </Style>
        <Style Selector="Border.artwork-drop-target.drag-over">
            <Setter Property="BorderBrush" Value="{DynamicResource DropTargetBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource DropHighlightBorderThickness}"/>
        </Style>
        <Style Selector="Border.artwork-drop-overlay">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.artwork-drop-target.drag-over Border.artwork-drop-overlay">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">
        <!-- 上部ツールバー -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackgroundColor}"
                BorderBrush="{DynamicResource MainWindowBorderColor}"
                BorderThickness="{DynamicResource BottomBorderThickness}"
                Padding="{DynamicResource ToolbarPadding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource ToolbarSpacing}">
                    <Button Content="{DynamicResource OpenFolderButtonText}"
                            Command="{Binding OpenFolderCommand}"/>
                    <Button Content="{DynamicResource OpenFilesButtonText}"
                            Command="{Binding OpenFilesCommand}"/>

                    <Border Width="{DynamicResource ToolbarSeparatorWidth}"
                            Height="{DynamicResource ToolbarSeparatorHeight}"
                            Background="{DynamicResource MainWindowBorderColor}"
                            Margin="{DynamicResource ToolbarSeparatorMargin}"
                            VerticalAlignment="Center"/>

                    <Button Content="{DynamicResource SaveSelectedButtonText}"
                            Command="{Binding SaveSelectedCommand}"
                            ToolTip.Tip="{DynamicResource SaveSelectedToolTip}"/>
                    <Button Content="{DynamicResource SaveAllButtonText}"
                            Command="{Binding SaveAllCommand}"
                            ToolTip.Tip="{DynamicResource SaveAllToolTip}"/>
                    <Button Content="{DynamicResource RevertSelectedButtonText}"
                            Command="{Binding RevertSelectedCommand}"
                            ToolTip.Tip="{DynamicResource RevertSelectedToolTip}"/>
                    <Button Content="{DynamicResource RevertAllButtonText}"
                            Command="{Binding RevertAllCommand}"
                            ToolTip.Tip="{DynamicResource RevertAllToolTip}"/>

                    <Border Width="{DynamicResource ToolbarSeparatorWidth}"
                            Height="{DynamicResource ToolbarSeparatorHeight}"
                            Background="{DynamicResource MainWindowBorderColor}"
                            Margin="{DynamicResource ToolbarSeparatorMargin}"
                            VerticalAlignment="Center"/>

                    <Button Content="{DynamicResource PasteTsvButtonText}"
                            Command="{Binding #TracksDataGrid.(views:DataGridPasteBehavior.TriggerPasteCommand)}"
                            ToolTip.Tip="{DynamicResource PasteTsvToolTip}"/>
                    <ToggleButton Content="{DynamicResource SearchReplaceButtonText}"
                                  IsChecked="{Binding SearchReplace.IsOpen, Mode=OneWay}"
                                  Command="{Binding SearchReplace.ToggleBarCommand}"
                                  ToolTip.Tip="{DynamicResource SearchReplaceToolTip}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentSourcePath}"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           FontSize="{DynamicResource BodyFontSize}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource HorizontalTextMargin}"
                           ToolTip.Tip="{Binding CurrentSourcePath}"/>

                <ProgressBar Grid.Column="2"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="{DynamicResource LoadingProgressWidth}"
                             Height="{DynamicResource LoadingProgressHeight}"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 下部ステータスバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBackgroundColor}"
                BorderBrush="{DynamicResource MainWindowBorderColor}"
                BorderThickness="{DynamicResource TopBorderThickness}"
                Padding="{DynamicResource StatusBarPadding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextColor}"
                           FontSize="{DynamicResource StatusFontSize}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedTrack.FilePath, FallbackValue=''}"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           FontSize="{DynamicResource StatusFontSize}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource HorizontalTextMargin}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource StatusRightSpacing}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DirtyCountText}"
                               IsVisible="{Binding HasDirtyTracks}"
                               Foreground="{DynamicResource DirtyIndicatorColor}"
                               FontSize="{DynamicResource StatusFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrackCountText}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource StatusFontSize}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中央メイン領域（左：一覧DataGrid、右：詳細タグ表示・編集） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="{StaticResource ListPaneMinWidth}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{StaticResource DetailPaneInitialWidth}"
                                  MinWidth="{StaticResource DetailPaneMinWidth}"
                                  MaxWidth="{StaticResource DetailPaneMaxWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン：FLACファイル一覧 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <!-- 検索・一括置換インラインバー（＋置換一覧プレビュー） -->
                <Border Grid.Row="0"
                        DataContext="{Binding SearchReplace}"
                        x:DataType="vm:SearchReplaceViewModel"
                        IsVisible="{Binding IsOpen}"
                        Background="{DynamicResource SearchBarBackgroundColor}"
                        BorderBrush="{DynamicResource MainWindowBorderColor}"
                        BorderThickness="{DynamicResource BottomBorderThickness}">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
                    </Border.KeyBindings>
                    <StackPanel>
                        <StackPanel Margin="{DynamicResource SearchBarPadding}"
                                    Spacing="{DynamicResource SmallItemSpacing}">
                            <!-- 検索行 -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                  ColumnSpacing="{DynamicResource SmallItemSpacing}">
                                <ToggleButton Grid.Column="0"
                                              Content="{DynamicResource SearchToggleReplaceExpandText}"
                                              Classes="search-option"
                                              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}"
                                              Command="{Binding ToggleReplaceSectionCommand}"
                                              ToolTip.Tip="{DynamicResource SearchToggleReplaceToolTip}"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchPattern, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource SearchInputPlaceholder}"
                                         MinWidth="{DynamicResource SearchInputMinWidth}"
                                         Classes="editable-field"
                                         Classes.error="{Binding HasPatternError}"
                                         views:FocusBehavior.IsFocusRequested="{Binding IsSearchInputFocusRequested, Mode=TwoWay}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                                        <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <Button Grid.Column="2"
                                        Content="{DynamicResource SearchPreviousButtonText}"
                                        Command="{Binding FindPreviousCommand}"
                                        Width="{DynamicResource SearchNavButtonWidth}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        Padding="{DynamicResource CompactButtonPadding}"
                                        HorizontalContentAlignment="Center"
                                        ToolTip.Tip="{DynamicResource SearchPreviousToolTip}"/>

                                <Button Grid.Column="3"
                                        Content="{DynamicResource SearchNextButtonText}"
                                        Command="{Binding FindNextCommand}"
                                        Width="{DynamicResource SearchNavButtonWidth}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        Padding="{DynamicResource CompactButtonPadding}"
                                        HorizontalContentAlignment="Center"
                                        ToolTip.Tip="{DynamicResource SearchNextToolTip}"/>

                                <Button Grid.Column="4"
                                        Content="{DynamicResource SearchCloseButtonText}"
                                        Command="{Binding CloseCommand}"
                                        Width="{DynamicResource SearchCloseButtonWidth}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        Padding="{DynamicResource CompactButtonPadding}"
                                        HorizontalContentAlignment="Center"
                                        ToolTip.Tip="{DynamicResource SearchCloseToolTip}"/>
                            </Grid>

                            <!-- 置換行 -->
                            <Grid IsVisible="{Binding IsReplaceVisible}"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="{DynamicResource SmallItemSpacing}">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ReplacementText, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource ReplaceInputPlaceholder}"
                                         MinWidth="{DynamicResource SearchInputMinWidth}"
                                         Classes="editable-field"
                                         views:FocusBehavior.IsFocusRequested="{Binding IsReplaceInputFocusRequested, Mode=TwoWay}"/>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource SearchReplaceSelectedText}"
                                        Command="{Binding ReplaceSelectedCommand}"
                                        Padding="{DynamicResource SearchOptionPadding}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        FontSize="{DynamicResource LabelFontSize}"
                                        ToolTip.Tip="{DynamicResource SearchReplaceSelectedToolTip}"/>

                                <Button Grid.Column="2"
                                        Content="{DynamicResource SearchReplaceAllText}"
                                        Command="{Binding ReplaceAllCommand}"
                                        Padding="{DynamicResource SearchOptionPadding}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        FontSize="{DynamicResource LabelFontSize}"
                                        ToolTip.Tip="{DynamicResource SearchReplaceAllToolTip}"/>
                            </Grid>

                            <!-- オプション・一致件数行（狭幅時は自動折り返し） -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="{DynamicResource DetailItemSpacing}">
                                <WrapPanel Grid.Column="0"
                                           Orientation="Horizontal"
                                           ItemSpacing="{DynamicResource SmallItemSpacing}"
                                           LineSpacing="{DynamicResource SmallItemSpacing}">
                                    <ComboBox ItemsSource="{Binding TargetOptions}"
                                              SelectedItem="{Binding SelectedTargetOption, Mode=TwoWay}"
                                              Width="{DynamicResource SearchTargetComboWidth}"
                                              FontSize="{DynamicResource LabelFontSize}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource SearchTargetComboToolTip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SearchReplaceTargetOption">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ToggleButton Content="{DynamicResource SearchRegexButtonText}"
                                                  Classes="search-option"
                                                  IsChecked="{Binding UseRegex, Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource SearchRegexToolTip}"/>

                                    <ToggleButton Content="{DynamicResource SearchCaseButtonText}"
                                                  Classes="search-option"
                                                  IsChecked="{Binding IsCaseSensitive, Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource SearchCaseToolTip}"/>

                                    <ToggleButton Content="{DynamicResource SearchFilterButtonText}"
                                                  Classes="search-option"
                                                  IsChecked="{Binding FilterMatchingOnly, Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource SearchFilterToolTip}"/>

                                    <CheckBox Content="{DynamicResource SearchPreserveExtensionText}"
                                              IsVisible="{Binding IsReplaceVisible}"
                                              IsChecked="{Binding PreserveFileExtension, Mode=TwoWay}"
                                              IsEnabled="{Binding ShowPreserveExtensionOption}"
                                              FontSize="{DynamicResource LabelFontSize}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource SearchPreserveExtensionToolTip}"/>

                                    <ToggleButton Content="{DynamicResource SearchPreviewToggleText}"
                                                  IsVisible="{Binding IsReplaceVisible}"
                                                  Classes="search-option"
                                                  IsChecked="{Binding IsPreviewVisible, Mode=OneWay}"
                                                  Command="{Binding TogglePreviewCommand}"
                                                  ToolTip.Tip="{DynamicResource SearchPreviewToggleToolTip}"/>
                                </WrapPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding MatchSummaryText}"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"/>
                            </Grid>

                            <!-- パターン構文・タイムアウトエラー -->
                            <TextBlock Text="{Binding PatternError}"
                                       IsVisible="{Binding HasPatternError}"
                                       Foreground="{DynamicResource ErrorTextColor}"
                                       FontSize="{DynamicResource LabelFontSize}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 置換一覧プレビュー -->
                        <Border IsVisible="{Binding ShowPreviewPane}"
                                Background="{DynamicResource SearchPreviewBackgroundColor}"
                                BorderBrush="{DynamicResource SearchPreviewBorderColor}"
                                BorderThickness="{DynamicResource SearchPreviewBorderThickness}">
                            <StackPanel>
                                <Border Background="{DynamicResource SearchPreviewHeaderBackgroundColor}"
                                        BorderBrush="{DynamicResource SearchPreviewBorderColor}"
                                        BorderThickness="{DynamicResource BottomBorderThickness}"
                                        Padding="{DynamicResource SearchPreviewHeaderPadding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PreviewSummaryText}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="{DynamicResource LabelFontSize}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource SearchPreviewHintText}"
                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                   FontSize="{DynamicResource LabelFontSize}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource SearchPreviewEmptyText}"
                                           IsVisible="{Binding !HasPreviewItems}"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           Padding="{DynamicResource SearchPreviewEmptyPadding}"
                                           HorizontalAlignment="Center"/>

                                <DataGrid IsVisible="{Binding HasPreviewItems}"
                                          Classes="search-preview-grid"
                                          ItemsSource="{Binding PreviewItems}"
                                          SelectedItem="{Binding SelectedPreviewItem, Mode=TwoWay}"
                                          MaxHeight="{DynamicResource SearchPreviewMaxHeight}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource SearchPreviewGridLinesColor}"
                                          SelectionMode="Single"
                                          Background="{DynamicResource SearchPreviewBackgroundColor}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="トラック"
                                                            Binding="{Binding TrackDisplayName}"
                                                            SortMemberPath="TrackDisplayName"
                                                            Width="{StaticResource ColPreviewTrackWidth}"
                                                            MinWidth="{StaticResource ColPreviewTrackMinWidth}"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="項目"
                                                            Binding="{Binding FieldDisplayName}"
                                                            SortMemberPath="FieldDisplayName"
                                                            Width="{StaticResource ColPreviewFieldWidth}"
                                                            MinWidth="{StaticResource ColPreviewFieldMinWidth}"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="置換前"
                                                            Binding="{Binding BeforeValue}"
                                                            SortMemberPath="BeforeValue"
                                                            Width="{StaticResource ColPreviewBeforeWidth}"
                                                            MinWidth="{StaticResource ColPreviewValueMinWidth}"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="置換後"
                                                            Binding="{Binding AfterValue}"
                                                            SortMemberPath="AfterValue"
                                                            Width="{StaticResource ColPreviewAfterWidth}"
                                                            MinWidth="{StaticResource ColPreviewValueMinWidth}"
                                                            IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="状態"
                                                                SortMemberPath="StatusDisplay"
                                                                Width="{StaticResource ColPreviewStatusWidth}"
                                                                MinWidth="{StaticResource ColPreviewStatusMinWidth}"
                                                                IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:SearchReplacePreviewItem">
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               ToolTip.Tip="{Binding StatusDisplay}"
                                                               Classes="preview-status"
                                                               Classes.warning="{Binding HasWarning}"
                                                               Margin="{DynamicResource CompactButtonPadding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- トラック一覧 DataGrid -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="TracksDataGrid"
                              ItemsSource="{Binding DisplayedTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Background="{DynamicResource MainWindowBackgroundColor}"
                              views:DataGridPasteBehavior.PasteCommand="{Binding PasteTsvCommand}"
                              views:DataGridSelectionBehavior.ScrollSelectedItemIntoView="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource PasteTsvContextMenuText}"
                                      Command="{Binding #TracksDataGrid.(views:DataGridPasteBehavior.TriggerPasteCommand)}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header=""
                                                Width="{StaticResource ColDirtyWidth}"
                                                IsReadOnly="True"
                                                CanUserResize="False"
                                                views:DataGridPasteBehavior.ColumnKind="Dirty"
                                                SortMemberPath="IsDirty">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <TextBlock Text="{Binding DirtyIndicator}"
                                               Foreground="{DynamicResource DirtyIndicatorColor}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding TrackDisplay, Mode=TwoWay}"
                                            Width="{StaticResource ColTrackWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Track"
                                            SortMemberPath="TrackNumber"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="タイトル"
                                            Binding="{Binding Title, Mode=TwoWay}"
                                            Width="{StaticResource ColTitleWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Title"
                                            SortMemberPath="Title"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アーティスト"
                                            Binding="{Binding Artist, Mode=TwoWay}"
                                            Width="{StaticResource ColArtistWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Artist"
                                            SortMemberPath="Artist"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アルバム"
                                            Binding="{Binding Album, Mode=TwoWay}"
                                            Width="{StaticResource ColAlbumWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Album"
                                            SortMemberPath="Album"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アルバムアーティスト"
                                            Binding="{Binding AlbumArtist, Mode=TwoWay}"
                                            Width="{StaticResource ColAlbumArtistWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="AlbumArtist"
                                            SortMemberPath="AlbumArtist"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="年"
                                            Binding="{Binding YearText, Mode=TwoWay}"
                                            Width="{StaticResource ColYearWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Year"
                                            SortMemberPath="Year"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="時間"
                                            Binding="{Binding DurationDisplay}"
                                            Width="{StaticResource ColDurationWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Duration"
                                            SortMemberPath="Duration"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="ファイル名"
                                            Binding="{Binding FileName}"
                                            Width="{StaticResource ColFileNameWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="FileName"
                                            SortMemberPath="FileName"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                    </DataGrid>

                    <!-- 未読み込み時プレースホルダー -->
                    <TextBlock Text="{DynamicResource EmptyListPlaceholderText}"
                               IsVisible="{Binding !HasTracks}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource PlaceholderFontSize}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- フィルタ一致なしプレースホルダー -->
                    <TextBlock Text="{DynamicResource FilterEmptyPlaceholderText}"
                               IsVisible="{Binding IsFilterEmpty}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource PlaceholderFontSize}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- ペイン区切りスプリッター -->
            <GridSplitter Grid.Column="1"
                          Width="{DynamicResource SplitterWidth}"
                          Background="{DynamicResource SplitterColor}"
                          ResizeDirection="Columns"/>

            <!-- 右ペイン：選択中トラックの詳細タグ表示・編集 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource DetailPaneBackgroundColor}">
                <Grid>
                    <!-- 未選択時プレースホルダー -->
                    <TextBlock Text="{DynamicResource NoSelectionPlaceholderText}"
                               IsVisible="{Binding !HasSelectedTrack}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Margin="{DynamicResource DetailPanePadding}"/>

                    <!-- 選択中トラック詳細（上部：バナー専用領域、下部：スクロール可能な詳細編集領域） -->
                    <Grid IsVisible="{Binding HasSelectedTrack}"
                          RowDefinitions="Auto,*">

                        <!-- 未保存状態バナー専用領域 -->
                        <Border Grid.Row="0"
                                DataContext="{Binding SelectedTrack}"
                                x:DataType="vm:TrackItemViewModel"
                                Padding="{DynamicResource DetailBannerAreaPadding}"
                                BorderBrush="{DynamicResource MainWindowBorderColor}"
                                BorderThickness="{DynamicResource BottomBorderThickness}">
                            <Border Background="{DynamicResource DirtyBannerBackgroundColor}"
                                    BorderBrush="{DynamicResource DirtyBannerBorderColor}"
                                    BorderThickness="{DynamicResource ThinBorderThickness}"
                                    CornerRadius="{DynamicResource DefaultCornerRadius}"
                                    Padding="{DynamicResource DirtyBannerPadding}"
                                    Classes="dirty-banner"
                                    Classes.visible="{Binding IsDirty}"
                                    IsHitTestVisible="{Binding IsDirty}">
                                <TextBlock Text="{DynamicResource UnsavedTrackBannerText}"
                                           Foreground="{DynamicResource DirtyIndicatorColor}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Border>

                        <!-- アートワーク・タグ・ファイル情報 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="{DynamicResource DetailPanePadding}"
                                        DataContext="{Binding SelectedTrack}"
                                        x:DataType="vm:TrackItemViewModel">

                                <!-- アートワーク表示・設定（D&D対応） -->
                                <StackPanel HorizontalAlignment="Center"
                                            Spacing="{DynamicResource DetailItemSpacing}">
                                    <Border Width="{DynamicResource ArtworkContainerSize}"
                                            Height="{DynamicResource ArtworkContainerSize}"
                                            Background="{DynamicResource CardBackgroundColor}"
                                            CornerRadius="{DynamicResource DefaultCornerRadius}"
                                            ClipToBounds="True"
                                            Classes="artwork-drop-target"
                                            DragDrop.AllowDrop="True"
                                            views:ArtworkDropBehavior.DropCommand="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DropArtworkCommand}">
                                        <Grid>
                                            <Image Source="{Binding ArtworkBitmap}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding HasArtwork}"/>
                                            <TextBlock Text="{DynamicResource NoArtworkPlaceholderText}"
                                                       IsVisible="{Binding !HasArtwork}"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Padding="{DynamicResource ArtworkHintPadding}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border Classes="artwork-drop-overlay"
                                                    Background="{DynamicResource DropTargetOverlayBackgroundColor}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text="{DynamicResource ArtworkDropActiveText}"
                                                           Foreground="{DynamicResource TextColor}"
                                                           FontSize="{DynamicResource BodyFontSize}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Padding="{DynamicResource ArtworkHintPadding}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding ArtworkInfoDisplay}"
                                               Foreground="{DynamicResource SecondaryTextColor}"
                                               FontSize="{DynamicResource LabelFontSize}"
                                               HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="{DynamicResource DetailItemSpacing}">
                                        <Button Content="{DynamicResource SelectArtworkButtonText}"
                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectArtworkCommand}"
                                                ToolTip.Tip="{DynamicResource SelectArtworkToolTip}"
                                                Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                FontSize="{DynamicResource LabelFontSize}"/>
                                        <Button Content="{DynamicResource RemoveArtworkButtonText}"
                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveArtworkCommand}"
                                                ToolTip.Tip="{DynamicResource RemoveArtworkToolTip}"
                                                Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                FontSize="{DynamicResource LabelFontSize}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 基本タグ -->
                                <TextBlock Text="基本タグ" Classes="section-header"/>

                                <TextBlock Text="タイトル" Classes="field-label"/>
                                <TextBox Text="{Binding Title, Mode=TwoWay}" Classes="editable-field"/>

                                <TextBlock Text="アーティスト" Classes="field-label"/>
                                <TextBox Text="{Binding Artist, Mode=TwoWay}" Classes="editable-field"/>

                                <TextBlock Text="アルバム" Classes="field-label"/>
                                <TextBox Text="{Binding Album, Mode=TwoWay}" Classes="editable-field"/>

                                <TextBlock Text="アルバムアーティスト" Classes="field-label"/>
                                <TextBox Text="{Binding AlbumArtist, Mode=TwoWay}" Classes="editable-field"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource DetailItemSpacing}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="トラック (番号 / 総数)" Classes="field-label"/>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding TrackNumberText, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource CounterNumberPlaceholder}"
                                                     Classes="editable-field"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource CounterSeparatorText}"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       Margin="{DynamicResource CounterSeparatorMargin}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding TrackCountText, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource CounterTotalPlaceholder}"
                                                     Classes="editable-field"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ディスク (番号 / 総数)" Classes="field-label"/>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding DiscNumberText, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource CounterNumberPlaceholder}"
                                                     Classes="editable-field"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource CounterSeparatorText}"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       Margin="{DynamicResource CounterSeparatorMargin}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding DiscCountText, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource CounterTotalPlaceholder}"
                                                     Classes="editable-field"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,2*" ColumnSpacing="{DynamicResource DetailItemSpacing}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="年" Classes="field-label"/>
                                        <TextBox Text="{Binding YearText, Mode=TwoWay}"
                                                 PlaceholderText="{DynamicResource YearPlaceholder}"
                                                 Classes="editable-field"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ジャンル" Classes="field-label"/>
                                        <TextBox Text="{Binding Genre, Mode=TwoWay}" Classes="editable-field"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="コメント" Classes="field-label"/>
                                <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                         Classes="editable-field"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="{DynamicResource CommentFieldMinHeight}"/>

                                <!-- 独自タグ (Vorbis Comment) -->
                                <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource SectionMargin}">
                                    <TextBlock Grid.Column="0"
                                               Text="独自タグ (Vorbis Comment)"
                                               Foreground="{DynamicResource SectionHeaderColor}"
                                               FontSize="{DynamicResource SectionHeaderFontSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource AddCustomTagButtonText}"
                                            Command="{Binding AddCustomTagCommand}"
                                            Padding="{DynamicResource CompactButtonPadding}"
                                            MinHeight="{DynamicResource CompactButtonMinHeight}"
                                            FontSize="{DynamicResource LabelFontSize}"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource NoCustomTagsPlaceholderText}"
                                           IsVisible="{Binding !HasCustomTags}"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           TextWrapping="Wrap"/>

                                <ItemsControl ItemsSource="{Binding CustomTags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomTagItemViewModel">
                                            <Border Background="{DynamicResource CardBackgroundColor}"
                                                    BorderBrush="{DynamicResource MainWindowBorderColor}"
                                                    BorderThickness="{DynamicResource ThinBorderThickness}"
                                                    CornerRadius="{DynamicResource DefaultCornerRadius}"
                                                    Padding="{DynamicResource CustomTagCardPadding}"
                                                    Margin="{DynamicResource CustomTagCardMargin}">
                                                <StackPanel Spacing="{DynamicResource SmallItemSpacing}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="{DynamicResource SmallItemSpacing}">
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Key, Mode=TwoWay}"
                                                                 PlaceholderText="{DynamicResource CustomTagKeyPlaceholder}"
                                                                 Classes="editable-field"
                                                                 Classes.error="{Binding HasKeyError}"
                                                                 views:FocusBehavior.IsFocusRequested="{Binding IsFocusRequested, Mode=TwoWay}"/>
                                                        <Button Grid.Column="1"
                                                                Content="{DynamicResource RemoveCustomTagButtonText}"
                                                                Command="{Binding RemoveCommand}"
                                                                ToolTip.Tip="{DynamicResource RemoveCustomTagToolTip}"
                                                                Width="{DynamicResource RemoveTagButtonWidth}"
                                                                Padding="{DynamicResource CompactButtonPadding}"
                                                                HorizontalContentAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding KeyValidationError}"
                                                               IsVisible="{Binding HasKeyError}"
                                                               Foreground="{DynamicResource ErrorTextColor}"
                                                               FontSize="{DynamicResource LabelFontSize}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CustomTagValuePlaceholder}"
                                                             Classes="editable-field"
                                                             TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ファイル・音声情報 -->
                                <TextBlock Text="ファイル・音声情報" Classes="section-header"/>

                                <TextBlock Text="ファイル名" Classes="field-label"/>
                                <TextBox Text="{Binding FileName, Mode=OneWay}"
                                         Classes="readonly-field"
                                         Classes.error="{Binding HasFileNameError}"/>
                                <TextBlock Text="{Binding FileNameValidationError}"
                                           IsVisible="{Binding HasFileNameError}"
                                           Foreground="{DynamicResource ErrorTextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="フルパス" Classes="field-label"/>
                                <TextBox Text="{Binding FilePath, Mode=OneWay}"
                                         Classes="readonly-field"
                                         TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource DetailItemSpacing}">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="再生時間" Classes="field-label"/>
                                        <TextBox Text="{Binding DurationDisplay, Mode=OneWay}" Classes="readonly-field"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ファイルサイズ" Classes="field-label"/>
                                        <TextBox Text="{Binding FileSizeDisplay, Mode=OneWay}" Classes="readonly-field"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="音声フォーマット" Classes="field-label"/>
                                <TextBox Text="{Binding AudioSpecDisplay, Mode=OneWay}" Classes="readonly-field"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
