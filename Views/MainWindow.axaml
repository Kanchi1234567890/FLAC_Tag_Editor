<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:FLAC_Tag_Editor.Models"
        xmlns:vm="using:FLAC_Tag_Editor.ViewModels"
        xmlns:views="using:FLAC_Tag_Editor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Name="RootWindow"
        x:Class="FLAC_Tag_Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{DynamicResource MainWindowTitle}"
        Width="{DynamicResource MainWindowWidth}"
        Height="{DynamicResource MainWindowHeight}"
        MinWidth="{DynamicResource MainWindowMinWidth}"
        MinHeight="{DynamicResource MainWindowMinHeight}"
        CanResize="{DynamicResource MainWindowCanResize}"
        Background="{DynamicResource MainWindowBackgroundColor}"
        WindowDecorations="{DynamicResource MainWindowDecorations}"
        WindowStartupLocation="{DynamicResource MainWindowStartupLocation}"
        BorderBrush="{DynamicResource MainWindowBorderColor}"
        Topmost="{DynamicResource MainWindowTopmost}"
        views:WindowClosingBehavior.CloseGuard="{Binding}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding SearchReplace.OpenFindCommand}"/>
        <KeyBinding Gesture="Ctrl+H" Command="{Binding SearchReplace.OpenReplaceCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Resources/MainWindowResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground" Value="{DynamicResource SectionHeaderColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="{DynamicResource SectionMargin}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="Margin" Value="{DynamicResource FieldLabelMargin}"/>
        </Style>
        <Style Selector="TextBox.editable-field">
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource EditableFieldBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EditableFieldBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
        </Style>
        <Style Selector="TextBox.editable-field.error">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderColor}"/>
        </Style>
        <Style Selector="TextBox.readonly-field">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource ReadOnlyFieldBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ReadOnlyFieldBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
        </Style>
        <Style Selector="TextBox.readonly-field.error">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderColor}"/>
        </Style>
        <Style Selector="ToggleButton.search-option">
            <Setter Property="Padding" Value="{DynamicResource SearchOptionPadding}"/>
            <Setter Property="MinHeight" Value="{DynamicResource CompactButtonMinHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.search-option:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SearchOptionCheckedBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchOptionCheckedBorderColor}"/>
        </Style>
        <Style Selector="Button.inline-clear">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
            <Setter Property="Width" Value="{DynamicResource InlineClearButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource InlineClearButtonSize}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="{DynamicResource InlineClearButtonPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource InlineClearButtonMargin}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style Selector="Button.inline-clear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InlineClearButtonHoverBackgroundColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
        <Style Selector="TextBlock.preview-status">
            <Setter Property="Foreground" Value="{DynamicResource PreviewReadyTextColor}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.preview-status.warning">
            <Setter Property="Foreground" Value="{DynamicResource PreviewWarningTextColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="DataGrid.search-preview-grid DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SearchPreviewColumnHeaderBackgroundColor}"/>
        </Style>
        <Style Selector="Border.dirty-banner">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.dirty-banner.visible">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.artwork-drop-target">
            <Setter Property="BorderBrush" Value="{DynamicResource MainWindowBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
        </Style>
        <Style Selector="Border.artwork-drop-target.drag-over">
            <Setter Property="BorderBrush" Value="{DynamicResource DropTargetBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource DropHighlightBorderThickness}"/>
        </Style>
        <Style Selector="Border.artwork-drop-overlay">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.artwork-drop-target.drag-over Border.artwork-drop-overlay">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox.artwork-thumbnails">
            <Setter Property="Background" Value="{DynamicResource ReadOnlyFieldBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MainWindowBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{DynamicResource ArtworkThumbListPadding}"/>
        </Style>
        <Style Selector="ListBox.artwork-thumbnails ListBoxItem">
            <Setter Property="Padding" Value="{DynamicResource ArtworkThumbItemPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource ArtworkThumbItemMargin}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MainWindowBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        </Style>
        <Style Selector="ListBox.artwork-thumbnails ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArtworkThumbHoverBackgroundColor}"/>
        </Style>
        <Style Selector="ListBox.artwork-thumbnails ListBoxItem:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource ArtworkThumbSelectedBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource DropHighlightBorderThickness}"/>
            <Setter Property="Background" Value="{DynamicResource ArtworkThumbSelectedBackgroundColor}"/>
        </Style>
        <Style Selector="ListBox.artwork-thumbnails ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sync-artwork-button">
            <Setter Property="Background" Value="{DynamicResource SyncButtonBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SyncButtonBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="Padding" Value="{DynamicResource ArtworkActionButtonPadding}"/>
            <Setter Property="MinHeight" Value="{DynamicResource CompactButtonMinHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
        </Style>
        <Style Selector="Button.player-transport">
            <Setter Property="Width" Value="{DynamicResource PlayerTransportButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource PlayerTransportButtonSize}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.player-primary">
            <Setter Property="Width" Value="{DynamicResource PlayerPlayPauseButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource PlayerPlayPauseButtonSize}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource PlayerPrimaryButtonBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerPrimaryButtonBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.player-mute">
            <Setter Property="Width" Value="{DynamicResource PlayerMuteButtonSize}"/>
            <Setter Property="Height" Value="{DynamicResource PlayerMuteButtonSize}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.player-select-play">
            <Setter Property="Background" Value="{DynamicResource PlayerPrimaryButtonBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerPrimaryButtonBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{DynamicResource PlayerSelectPlayButtonPadding}"/>
            <Setter Property="MinHeight" Value="{DynamicResource CompactButtonMinHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.player-status-badge">
            <Setter Property="Background" Value="{DynamicResource PlayerStatusBadgeBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerStatusBadgeBorderColor}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThinBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{DynamicResource PlayerStatusBadgePadding}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.player-status-badge.playing">
            <Setter Property="Background" Value="{DynamicResource PlayerStatusPlayingBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerStatusPlayingBorderColor}"/>
        </Style>
        <Style Selector="Border.player-status-badge.paused">
            <Setter Property="Background" Value="{DynamicResource PlayerStatusPausedBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerStatusPausedBorderColor}"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">
        <!-- 上部ツールバー -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackgroundColor}"
                BorderBrush="{DynamicResource MainWindowBorderColor}"
                BorderThickness="{DynamicResource BottomBorderThickness}"
                Padding="{DynamicResource ToolbarPadding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource ToolbarSpacing}">
                    <SplitButton Content="{DynamicResource OpenFolderButtonText}"
                                 Command="{Binding OpenFolderCommand}"
                                 ToolTip.Tip="{DynamicResource OpenFolderToolTip}">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{DynamicResource OpenFolderReplaceMenuText}"
                                          Command="{Binding OpenFolderCommand}"/>
                                <MenuItem Header="{DynamicResource AppendFolderMenuText}"
                                          Command="{Binding AppendFolderCommand}"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton Content="{DynamicResource OpenFilesButtonText}"
                                 Command="{Binding OpenFilesCommand}"
                                 ToolTip.Tip="{DynamicResource OpenFilesToolTip}">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{DynamicResource OpenFilesReplaceMenuText}"
                                          Command="{Binding OpenFilesCommand}"/>
                                <MenuItem Header="{DynamicResource AppendFilesMenuText}"
                                          Command="{Binding AppendFilesCommand}"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Content="{DynamicResource ClearTrackListButtonText}"
                            Command="{Binding ClearTrackListCommand}"
                            ToolTip.Tip="{DynamicResource ClearTrackListToolTip}"/>

                    <Border Width="{DynamicResource ToolbarSeparatorWidth}"
                            Height="{DynamicResource ToolbarSeparatorHeight}"
                            Background="{DynamicResource MainWindowBorderColor}"
                            Margin="{DynamicResource ToolbarSeparatorMargin}"
                            VerticalAlignment="Center"/>

                    <Button Content="{DynamicResource SaveSelectedButtonText}"
                            Command="{Binding SaveSelectedCommand}"
                            ToolTip.Tip="{DynamicResource SaveSelectedToolTip}"/>
                    <Button Content="{DynamicResource SaveAllButtonText}"
                            Command="{Binding SaveAllCommand}"
                            ToolTip.Tip="{DynamicResource SaveAllToolTip}"/>
                    <Button Content="{DynamicResource RevertSelectedButtonText}"
                            Command="{Binding RevertSelectedCommand}"
                            ToolTip.Tip="{DynamicResource RevertSelectedToolTip}"/>
                    <Button Content="{DynamicResource RevertAllButtonText}"
                            Command="{Binding RevertAllCommand}"
                            ToolTip.Tip="{DynamicResource RevertAllToolTip}"/>

                    <Border Width="{DynamicResource ToolbarSeparatorWidth}"
                            Height="{DynamicResource ToolbarSeparatorHeight}"
                            Background="{DynamicResource MainWindowBorderColor}"
                            Margin="{DynamicResource ToolbarSeparatorMargin}"
                            VerticalAlignment="Center"/>

                    <Button Content="{DynamicResource PasteTsvButtonText}"
                            Command="{Binding #TracksDataGrid.(views:DataGridPasteBehavior.TriggerPasteCommand)}"
                            ToolTip.Tip="{DynamicResource PasteTsvToolTip}"/>
                    <ToggleButton Content="{DynamicResource SearchReplaceButtonText}"
                                  IsChecked="{Binding SearchReplace.IsOpen, Mode=OneWay}"
                                  Command="{Binding SearchReplace.ToggleBarCommand}"
                                  ToolTip.Tip="{DynamicResource SearchReplaceToolTip}"/>
                    <SplitButton Content="{DynamicResource ReplayGainButtonText}"
                                 Command="{Binding CalculateReplayGainCommand}"
                                 ToolTip.Tip="{DynamicResource ReplayGainButtonToolTip}">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{DynamicResource ReplayGainCalculateMenuText}"
                                          Command="{Binding CalculateReplayGainCommand}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource ReplayGainClearSelectedMenuText}"
                                          Command="{Binding ClearSelectedReplayGainCommand}"/>
                                <MenuItem Header="{DynamicResource ReplayGainClearAllMenuText}"
                                          Command="{Binding ClearAllReplayGainCommand}"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Content="{DynamicResource ColumnsButtonText}"
                            ToolTip.Tip="{DynamicResource ColumnsButtonToolTip}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel MinWidth="{DynamicResource ColumnChooserFlyoutMinWidth}"
                                            Margin="{DynamicResource ColumnChooserFlyoutPadding}"
                                            Spacing="{DynamicResource ColumnChooserItemSpacing}">
                                    <ScrollViewer MaxHeight="{DynamicResource ColumnChooserFlyoutMaxHeight}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="{DynamicResource ColumnChooserItemSpacing}">
                                            <TextBlock Text="{DynamicResource ColumnChooserTitleText}"
                                                       Foreground="{DynamicResource SectionHeaderColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       Margin="{DynamicResource ColumnChooserHeaderMargin}"/>
                                            <ItemsControl ItemsSource="{Binding ColumnSettings.StandardToggleableColumns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TrackGridColumnOptionViewModel">
                                                        <CheckBox Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  FontSize="{DynamicResource BodyFontSize}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel IsVisible="{Binding ColumnSettings.HasCustomTagColumns}"
                                                        Spacing="{DynamicResource ColumnChooserItemSpacing}">
                                                <Border Height="{DynamicResource ColumnChooserDividerHeight}"
                                                        Background="{DynamicResource MainWindowBorderColor}"
                                                        Margin="{DynamicResource ColumnChooserDividerMargin}"/>
                                                <TextBlock Text="{DynamicResource ColumnChooserCustomTagsTitleText}"
                                                           Foreground="{DynamicResource SectionHeaderColor}"
                                                           FontSize="{DynamicResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           Margin="{DynamicResource ColumnChooserHeaderMargin}"/>
                                                <ItemsControl ItemsSource="{Binding ColumnSettings.CustomTagToggleableColumns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TrackGridColumnOptionViewModel">
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanToggle}"
                                                                      FontSize="{DynamicResource BodyFontSize}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Height="{DynamicResource ColumnChooserDividerHeight}"
                                            Background="{DynamicResource MainWindowBorderColor}"
                                            Margin="{DynamicResource ColumnChooserDividerMargin}"/>
                                    <Button Content="{DynamicResource ResetColumnsButtonText}"
                                            Command="{Binding ColumnSettings.ResetColumnsCommand}"
                                            ToolTip.Tip="{DynamicResource ResetColumnsToolTip}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            MinHeight="{DynamicResource CompactButtonMinHeight}"
                                            Padding="{DynamicResource CompactButtonPadding}"
                                            FontSize="{DynamicResource LabelFontSize}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentSourcePath}"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           FontSize="{DynamicResource BodyFontSize}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource HorizontalTextMargin}"
                           ToolTip.Tip="{Binding CurrentSourcePath}"/>

                <ProgressBar Grid.Column="2"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="{DynamicResource LoadingProgressWidth}"
                             Height="{DynamicResource LoadingProgressHeight}"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 下部ステータスバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBackgroundColor}"
                BorderBrush="{DynamicResource MainWindowBorderColor}"
                BorderThickness="{DynamicResource TopBorderThickness}"
                Padding="{DynamicResource StatusBarPadding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextColor}"
                           FontSize="{DynamicResource StatusFontSize}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedTrack.FilePath, FallbackValue=''}"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           FontSize="{DynamicResource StatusFontSize}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource HorizontalTextMargin}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource StatusRightSpacing}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCountText}"
                               IsVisible="{Binding HasMultipleSelectedTracks}"
                               Foreground="{DynamicResource SectionHeaderColor}"
                               FontSize="{DynamicResource StatusFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DirtyCountText}"
                               IsVisible="{Binding HasDirtyTracks}"
                               Foreground="{DynamicResource DirtyIndicatorColor}"
                               FontSize="{DynamicResource StatusFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrackCountText}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource StatusFontSize}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 下部簡易 FLAC プレーヤーバー -->
        <Border DockPanel.Dock="Bottom"
                DataContext="{Binding AudioPlayer}"
                x:DataType="vm:AudioPlayerViewModel"
                Background="{DynamicResource PlayerBarBackgroundColor}"
                BorderBrush="{DynamicResource MainWindowBorderColor}"
                BorderThickness="{DynamicResource TopBorderThickness}"
                Padding="{DynamicResource PlayerBarPadding}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="{DynamicResource PlayerBarSectionSpacing}">
                <!-- 再生・一時停止・停止・前/次トラック -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource PlayerControlSpacing}"
                            VerticalAlignment="Center">
                    <Button Classes="player-transport"
                            Command="{Binding PreviousTrackCommand}"
                            ToolTip.Tip="{DynamicResource PlayerPreviousToolTip}">
                        <PathIcon Data="{DynamicResource PlayerPreviousIconGeometry}"
                                  Width="{DynamicResource PlayerIconSize}"
                                  Height="{DynamicResource PlayerIconSize}"/>
                    </Button>

                    <Button Classes="player-primary"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip.Tip="{Binding PlayPauseToolTip}">
                        <Panel>
                            <PathIcon Data="{DynamicResource PlayerPlayIconGeometry}"
                                      IsVisible="{Binding !IsPlaying}"
                                      Width="{DynamicResource PlayerPlayIconSize}"
                                      Height="{DynamicResource PlayerPlayIconSize}"/>
                            <PathIcon Data="{DynamicResource PlayerPauseIconGeometry}"
                                      IsVisible="{Binding IsPlaying}"
                                      Width="{DynamicResource PlayerPlayIconSize}"
                                      Height="{DynamicResource PlayerPlayIconSize}"/>
                        </Panel>
                    </Button>

                    <Button Classes="player-transport"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="{DynamicResource PlayerStopToolTip}">
                        <PathIcon Data="{DynamicResource PlayerStopIconGeometry}"
                                  Width="{DynamicResource PlayerIconSize}"
                                  Height="{DynamicResource PlayerIconSize}"/>
                    </Button>

                    <Button Classes="player-transport"
                            Command="{Binding NextTrackCommand}"
                            ToolTip.Tip="{DynamicResource PlayerNextToolTip}">
                        <PathIcon Data="{DynamicResource PlayerNextIconGeometry}"
                                  Width="{DynamicResource PlayerIconSize}"
                                  Height="{DynamicResource PlayerIconSize}"/>
                    </Button>
                </StackPanel>

                <!-- 再生中トラック情報 + 別行選択時の「選択曲を再生」ボタン -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource DetailItemSpacing}"
                            VerticalAlignment="Center">
                    <StackPanel MinWidth="{DynamicResource PlayerTrackInfoMinWidth}"
                                MaxWidth="{DynamicResource PlayerTrackInfoMaxWidth}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding PlayingTrackToolTip}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{DynamicResource SmallItemSpacing}">
                            <Border Classes="player-status-badge"
                                    Classes.playing="{Binding IsPlaying}"
                                    Classes.paused="{Binding IsPaused}"
                                    IsVisible="{Binding HasPlayingStatusBadge}">
                                <TextBlock Text="{Binding PlayingStatusBadgeText}"
                                           Foreground="{DynamicResource TextColor}"
                                           FontSize="{DynamicResource SmallLabelFontSize}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding PlayingTrackTitleDisplay}"
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlayingTrackSubTextDisplay}"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   FontSize="{DynamicResource LabelFontSize}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Classes="player-select-play"
                            IsVisible="{Binding HasDifferentSelectedTrack}"
                            Command="{Binding PlaySelectedTrackCommand}"
                            ToolTip.Tip="{Binding PlaySelectedTrackToolTip}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{DynamicResource PlayerControlSpacing}"
                                    VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource PlayerPlayIconGeometry}"
                                      Width="{DynamicResource PlayerMiniIconSize}"
                                      Height="{DynamicResource PlayerMiniIconSize}"/>
                            <TextBlock Text="{DynamicResource PlayerPlaySelectedButtonText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- シークバー・経過／総時間 -->
                <Grid Grid.Column="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="{DynamicResource PlayerSeekSpacing}"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeText}"
                               MinWidth="{DynamicResource PlayerTimeTextMinWidth}"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextColor}"
                               FontSize="{DynamicResource LabelFontSize}"
                               VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding SliderMaximum}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            SmallChange="5"
                            LargeChange="15"
                            IsEnabled="{Binding CanSeek}"
                            MinWidth="{DynamicResource PlayerSeekSliderMinWidth}"
                            VerticalAlignment="Center"
                            views:SliderSeekBehavior.SeekHandler="{Binding}"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalTimeText}"
                               MinWidth="{DynamicResource PlayerTimeTextMinWidth}"
                               TextAlignment="Left"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource LabelFontSize}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ミュート・音量調整 -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource SmallItemSpacing}"
                            VerticalAlignment="Center">
                    <Button Classes="player-mute"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip.Tip="{Binding MuteToolTip}">
                        <Panel>
                            <PathIcon Data="{DynamicResource PlayerVolumeIconGeometry}"
                                      IsVisible="{Binding !IsMuted}"
                                      Width="{DynamicResource PlayerIconSize}"
                                      Height="{DynamicResource PlayerIconSize}"/>
                            <PathIcon Data="{DynamicResource PlayerMuteIconGeometry}"
                                      IsVisible="{Binding IsMuted}"
                                      Width="{DynamicResource PlayerIconSize}"
                                      Height="{DynamicResource PlayerIconSize}"/>
                        </Panel>
                    </Button>

                    <Slider Minimum="0"
                            Maximum="1"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Width="{DynamicResource PlayerVolumeSliderWidth}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource PlayerVolumeSliderToolTip}"/>

                    <TextBlock Text="{Binding VolumePercentText}"
                               MinWidth="{DynamicResource PlayerVolumeTextMinWidth}"
                               TextAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource LabelFontSize}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中央メイン領域（左：一覧DataGrid、右：詳細タグ表示・編集） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="{StaticResource ListPaneMinWidth}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{StaticResource DetailPaneInitialWidth}"
                                  MinWidth="{StaticResource DetailPaneMinWidth}"
                                  MaxWidth="{StaticResource DetailPaneMaxWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン：検索バー・可変高さプレビュー・FLACファイル一覧 -->
            <Grid Grid.Column="0"
                  views:CollapsibleRowBehavior.RowIndex="1"
                  views:CollapsibleRowBehavior.IsExpanded="{Binding SearchReplace.ShowPreviewPane}"
                  views:CollapsibleRowBehavior.DefaultHeight="{StaticResource SearchPreviewDefaultHeight}"
                  views:CollapsibleRowBehavior.ExpandedMinHeight="{StaticResource SearchPreviewMinHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="{StaticResource TrackListMinHeight}"/>
                </Grid.RowDefinitions>

                <!-- 検索・一括置換インラインバー本体 -->
                <Border Grid.Row="0"
                        DataContext="{Binding SearchReplace}"
                        x:DataType="vm:SearchReplaceViewModel"
                        IsVisible="{Binding IsOpen}"
                        Background="{DynamicResource SearchBarBackgroundColor}"
                        BorderBrush="{DynamicResource MainWindowBorderColor}"
                        BorderThickness="{DynamicResource BottomBorderThickness}">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
                    </Border.KeyBindings>
                    <StackPanel Margin="{DynamicResource SearchBarPadding}"
                                Spacing="{DynamicResource SmallItemSpacing}">
                        <!-- 検索行 -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                              ColumnSpacing="{DynamicResource SmallItemSpacing}">
                            <ToggleButton Grid.Column="0"
                                          Content="{DynamicResource SearchToggleReplaceExpandText}"
                                          Classes="search-option"
                                          IsChecked="{Binding IsReplaceVisible, Mode=OneWay}"
                                          Command="{Binding ToggleReplaceSectionCommand}"
                                          ToolTip.Tip="{DynamicResource SearchToggleReplaceToolTip}"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchPattern, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource SearchInputPlaceholder}"
                                     MinWidth="{DynamicResource SearchInputMinWidth}"
                                     Classes="editable-field"
                                     Classes.error="{Binding HasPatternError}"
                                     views:FocusBehavior.IsFocusRequested="{Binding IsSearchInputFocusRequested, Mode=TwoWay}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                                    <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}"/>
                                </TextBox.KeyBindings>
                                <TextBox.InnerRightContent>
                                    <Button Content="{DynamicResource ClearSearchTextButtonText}"
                                            Classes="inline-clear"
                                            IsVisible="{Binding HasSearchPattern}"
                                            Command="{Binding ClearSearchPatternCommand}"
                                            ToolTip.Tip="{DynamicResource ClearSearchPatternToolTip}"/>
                                </TextBox.InnerRightContent>
                            </TextBox>

                            <Button Grid.Column="2"
                                    Content="{DynamicResource SearchPreviousButtonText}"
                                    Command="{Binding FindPreviousCommand}"
                                    Width="{DynamicResource SearchNavButtonWidth}"
                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                    Padding="{DynamicResource CompactButtonPadding}"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{DynamicResource SearchPreviousToolTip}"/>

                            <Button Grid.Column="3"
                                    Content="{DynamicResource SearchNextButtonText}"
                                    Command="{Binding FindNextCommand}"
                                    Width="{DynamicResource SearchNavButtonWidth}"
                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                    Padding="{DynamicResource CompactButtonPadding}"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{DynamicResource SearchNextToolTip}"/>

                            <Button Grid.Column="4"
                                    Content="{DynamicResource SearchCloseButtonText}"
                                    Command="{Binding CloseCommand}"
                                    Width="{DynamicResource SearchCloseButtonWidth}"
                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                    Padding="{DynamicResource CompactButtonPadding}"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{DynamicResource SearchCloseToolTip}"/>
                        </Grid>

                        <!-- 置換行 -->
                        <Grid IsVisible="{Binding IsReplaceVisible}"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="{DynamicResource SmallItemSpacing}">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ReplacementText, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource ReplaceInputPlaceholder}"
                                     MinWidth="{DynamicResource SearchInputMinWidth}"
                                     Classes="editable-field"
                                     views:FocusBehavior.IsFocusRequested="{Binding IsReplaceInputFocusRequested, Mode=TwoWay}">
                                <TextBox.InnerRightContent>
                                    <Button Content="{DynamicResource ClearSearchTextButtonText}"
                                            Classes="inline-clear"
                                            IsVisible="{Binding HasReplacementText}"
                                            Command="{Binding ClearReplacementTextCommand}"
                                            ToolTip.Tip="{DynamicResource ClearReplacementTextToolTip}"/>
                                </TextBox.InnerRightContent>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource SearchReplaceSelectedText}"
                                    Command="{Binding ReplaceSelectedCommand}"
                                    Padding="{DynamicResource SearchOptionPadding}"
                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                    FontSize="{DynamicResource LabelFontSize}"
                                    ToolTip.Tip="{DynamicResource SearchReplaceSelectedToolTip}"/>

                            <Button Grid.Column="2"
                                    Content="{DynamicResource SearchReplaceAllText}"
                                    Command="{Binding ReplaceAllCommand}"
                                    Padding="{DynamicResource SearchOptionPadding}"
                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                    FontSize="{DynamicResource LabelFontSize}"
                                    ToolTip.Tip="{DynamicResource SearchReplaceAllToolTip}"/>
                        </Grid>

                        <!-- オプション・一致件数行（狭幅時は自動折り返し） -->
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="{DynamicResource DetailItemSpacing}">
                            <WrapPanel Grid.Column="0"
                                       Orientation="Horizontal"
                                       ItemSpacing="{DynamicResource SmallItemSpacing}"
                                       LineSpacing="{DynamicResource SmallItemSpacing}">
                                <ComboBox ItemsSource="{Binding TargetOptions}"
                                          SelectedItem="{Binding SelectedTargetOption, Mode=TwoWay}"
                                          Width="{DynamicResource SearchTargetComboWidth}"
                                          FontSize="{DynamicResource LabelFontSize}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{DynamicResource SearchTargetComboToolTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:SearchReplaceTargetOption">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ToggleButton Content="{DynamicResource SearchRegexButtonText}"
                                              Classes="search-option"
                                              IsChecked="{Binding UseRegex, Mode=TwoWay}"
                                              ToolTip.Tip="{DynamicResource SearchRegexToolTip}"/>

                                <ToggleButton Content="{DynamicResource SearchCaseButtonText}"
                                              Classes="search-option"
                                              IsChecked="{Binding IsCaseSensitive, Mode=TwoWay}"
                                              ToolTip.Tip="{DynamicResource SearchCaseToolTip}"/>

                                <ToggleButton Content="{DynamicResource SearchFilterButtonText}"
                                              Classes="search-option"
                                              IsChecked="{Binding FilterMatchingOnly, Mode=TwoWay}"
                                              ToolTip.Tip="{DynamicResource SearchFilterToolTip}"/>

                                <CheckBox Content="{DynamicResource SearchPreserveExtensionText}"
                                          IsVisible="{Binding IsReplaceVisible}"
                                          IsChecked="{Binding PreserveFileExtension, Mode=TwoWay}"
                                          IsEnabled="{Binding ShowPreserveExtensionOption}"
                                          FontSize="{DynamicResource LabelFontSize}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{DynamicResource SearchPreserveExtensionToolTip}"/>

                                <ToggleButton Content="{DynamicResource SearchPreviewToggleText}"
                                              IsVisible="{Binding IsReplaceVisible}"
                                              Classes="search-option"
                                              IsChecked="{Binding IsPreviewVisible, Mode=OneWay}"
                                              Command="{Binding TogglePreviewCommand}"
                                              ToolTip.Tip="{DynamicResource SearchPreviewToggleToolTip}"/>
                            </WrapPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding MatchSummaryText}"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       FontSize="{DynamicResource LabelFontSize}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"/>
                        </Grid>

                        <!-- パターン構文・タイムアウトエラー -->
                        <TextBlock Text="{Binding PatternError}"
                                   IsVisible="{Binding HasPatternError}"
                                   Foreground="{DynamicResource ErrorTextColor}"
                                   FontSize="{DynamicResource LabelFontSize}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 置換一覧プレビュー（高さ可変） -->
                <Border Grid.Row="1"
                        DataContext="{Binding SearchReplace}"
                        x:DataType="vm:SearchReplaceViewModel"
                        IsVisible="{Binding ShowPreviewPane}"
                        Background="{DynamicResource SearchPreviewBackgroundColor}"
                        BorderBrush="{DynamicResource SearchPreviewBorderColor}"
                        BorderThickness="{DynamicResource SearchPreviewBorderThickness}">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
                    </Border.KeyBindings>
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{DynamicResource SearchPreviewHeaderBackgroundColor}"
                                BorderBrush="{DynamicResource SearchPreviewBorderColor}"
                                BorderThickness="{DynamicResource BottomBorderThickness}"
                                Padding="{DynamicResource SearchPreviewHeaderPadding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PreviewSummaryText}"
                                           Foreground="{DynamicResource TextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource SearchPreviewHintText}"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           FontSize="{DynamicResource LabelFontSize}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <TextBlock Text="{DynamicResource SearchPreviewEmptyText}"
                                       IsVisible="{Binding !HasPreviewItems}"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       FontSize="{DynamicResource LabelFontSize}"
                                       Padding="{DynamicResource SearchPreviewEmptyPadding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <DataGrid IsVisible="{Binding HasPreviewItems}"
                                      Classes="search-preview-grid"
                                      ItemsSource="{Binding PreviewItems}"
                                      SelectedItem="{Binding SelectedPreviewItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource SearchPreviewGridLinesColor}"
                                      SelectionMode="Single"
                                      Background="{DynamicResource SearchPreviewBackgroundColor}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="トラック"
                                                        Binding="{Binding TrackDisplayName}"
                                                        SortMemberPath="TrackDisplayName"
                                                        Width="{StaticResource ColPreviewTrackWidth}"
                                                        MinWidth="{StaticResource ColPreviewTrackMinWidth}"
                                                        IsReadOnly="True"/>
                                    <DataGridTextColumn Header="項目"
                                                        Binding="{Binding FieldDisplayName}"
                                                        SortMemberPath="FieldDisplayName"
                                                        Width="{StaticResource ColPreviewFieldWidth}"
                                                        MinWidth="{StaticResource ColPreviewFieldMinWidth}"
                                                        IsReadOnly="True"/>
                                    <DataGridTextColumn Header="置換前"
                                                        Binding="{Binding BeforeValue}"
                                                        SortMemberPath="BeforeValue"
                                                        Width="{StaticResource ColPreviewBeforeWidth}"
                                                        MinWidth="{StaticResource ColPreviewValueMinWidth}"
                                                        IsReadOnly="True"/>
                                    <DataGridTextColumn Header="置換後"
                                                        Binding="{Binding AfterValue}"
                                                        SortMemberPath="AfterValue"
                                                        Width="{StaticResource ColPreviewAfterWidth}"
                                                        MinWidth="{StaticResource ColPreviewValueMinWidth}"
                                                        IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="状態"
                                                            SortMemberPath="StatusDisplay"
                                                            Width="{StaticResource ColPreviewStatusWidth}"
                                                            MinWidth="{StaticResource ColPreviewStatusMinWidth}"
                                                            IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:SearchReplacePreviewItem">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           ToolTip.Tip="{Binding StatusDisplay}"
                                                           Classes="preview-status"
                                                           Classes.warning="{Binding HasWarning}"
                                                           Margin="{DynamicResource CompactButtonPadding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- プレビュー欄リサイズ用水平スプリッター -->
                <GridSplitter Grid.Row="2"
                              IsVisible="{Binding SearchReplace.ShowPreviewPane}"
                              Height="{DynamicResource SplitterWidth}"
                              Background="{DynamicResource SplitterColor}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ToolTip.Tip="{DynamicResource SearchPreviewSplitterToolTip}"/>

                <!-- トラック一覧 DataGrid -->
                <Grid Grid.Row="3">
                    <DataGrid x:Name="TracksDataGrid"
                              ItemsSource="{Binding DisplayedTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Extended"
                              Background="{DynamicResource MainWindowBackgroundColor}"
                              views:DataGridPasteBehavior.PasteCommand="{Binding PasteTsvCommand}"
                              views:DataGridSelectionBehavior.ScrollSelectedItemIntoView="True"
                              views:DataGridSelectionBehavior.SelectedItems="{Binding SelectedTracks}"
                              views:DataGridColumnSettingsBehavior.ColumnSettings="{Binding ColumnSettings}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource PlaySelectedTrackContextMenuText}"
                                      Command="{Binding AudioPlayer.PlaySelectedTrackCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource PasteTsvContextMenuText}"
                                      Command="{Binding #TracksDataGrid.(views:DataGridPasteBehavior.TriggerPasteCommand)}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource ReplayGainContextMenuText}"
                                      Command="{Binding CalculateReplayGainSelectedCommand}"/>
                            <MenuItem Header="{DynamicResource ReplayGainClearSelectedContextMenuText}"
                                      Command="{Binding ClearSelectedReplayGainCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource AddArtworkContextMenuText}"
                                      Command="{Binding AddArtworkCommand}"/>
                            <MenuItem Header="{DynamicResource SyncArtworksContextMenuText}"
                                      Command="{Binding SyncArtworksToSelectionCommand}"/>
                            <MenuItem Header="{DynamicResource ClearAllArtworksContextMenuText}"
                                      Command="{Binding ClearAllArtworksCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource SaveSelectedContextMenuText}"
                                      Command="{Binding SaveSelectedCommand}"/>
                            <MenuItem Header="{DynamicResource RevertSelectedContextMenuText}"
                                      Command="{Binding RevertSelectedCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource ColumnsContextMenuText}"
                                      ItemsSource="{Binding ColumnSettings.ToggleableColumns}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackGridColumnOptionViewModel">
                                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                                        <Setter Property="ToggleType" Value="CheckBox"/>
                                        <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}"/>
                                        <Setter Property="IsEnabled" Value="{Binding CanToggle}"/>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource ResetColumnsButtonText}"
                                      Command="{Binding ColumnSettings.ResetColumnsCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource ClearTrackListContextMenuText}"
                                      Command="{Binding ClearTrackListCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header=""
                                                Width="{StaticResource ColDirtyWidth}"
                                                IsReadOnly="True"
                                                CanUserResize="False"
                                                views:DataGridPasteBehavior.ColumnKind="Dirty"
                                                SortMemberPath="IsDirty">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <TextBlock Text="{Binding DirtyIndicator}"
                                               Foreground="{DynamicResource DirtyIndicatorColor}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{StaticResource ColArtworkHeaderText}"
                                                Width="{StaticResource ColArtworkWidth}"
                                                IsReadOnly="True"
                                                CanUserResize="False"
                                                views:DataGridPasteBehavior.ColumnKind="Artwork"
                                                SortMemberPath="ArtworkCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <TextBlock Text="{Binding ArtworkIndicator}"
                                               IsVisible="{Binding HasArtworkData}"
                                               Foreground="{DynamicResource ArtworkIndicatorColor}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="{DynamicResource ArtworkCellMargin}"
                                               ToolTip.Tip="{Binding ArtworkToolTipText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding TrackDisplay, Mode=TwoWay}"
                                            Width="{StaticResource ColTrackWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Track"
                                            SortMemberPath="TrackNumber"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="タイトル"
                                            Binding="{Binding Title, Mode=TwoWay}"
                                            Width="{StaticResource ColTitleWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Title"
                                            SortMemberPath="Title"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アーティスト"
                                            Binding="{Binding Artist, Mode=TwoWay}"
                                            Width="{StaticResource ColArtistWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Artist"
                                            SortMemberPath="Artist"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アルバム"
                                            Binding="{Binding Album, Mode=TwoWay}"
                                            Width="{StaticResource ColAlbumWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Album"
                                            SortMemberPath="Album"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="アルバムアーティスト"
                                            Binding="{Binding AlbumArtist, Mode=TwoWay}"
                                            Width="{StaticResource ColAlbumArtistWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="AlbumArtist"
                                            SortMemberPath="AlbumArtist"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="年"
                                            Binding="{Binding YearText, Mode=TwoWay}"
                                            Width="{StaticResource ColYearWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Year"
                                            SortMemberPath="Year"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="時間"
                                            Binding="{Binding DurationDisplay}"
                                            Width="{StaticResource ColDurationWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Duration"
                                            SortMemberPath="Duration"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="ファイル名"
                                            Binding="{Binding FileName}"
                                            Width="{StaticResource ColFileNameWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="FileName"
                                            SortMemberPath="FileName"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="ディスク"
                                            Binding="{Binding DiscDisplay, Mode=TwoWay}"
                                            Width="{StaticResource ColDiscWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Disc"
                                            SortMemberPath="DiscNumber"
                                            IsVisible="False"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="ジャンル"
                                            Binding="{Binding Genre, Mode=TwoWay}"
                                            Width="{StaticResource ColGenreWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Genre"
                                            SortMemberPath="Genre"
                                            IsVisible="False"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="コメント"
                                            Binding="{Binding Comment, Mode=TwoWay}"
                                            Width="{StaticResource ColCommentWidth}"
                                            views:DataGridPasteBehavior.ColumnKind="Comment"
                                            SortMemberPath="Comment"
                                            IsVisible="False"
                                            IsReadOnly="False"/>
                    </DataGrid.Columns>
                    </DataGrid>

                    <!-- 未読み込み時プレースホルダー -->
                    <TextBlock Text="{DynamicResource EmptyListPlaceholderText}"
                               IsVisible="{Binding !HasTracks}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource PlaceholderFontSize}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- フィルタ一致なしプレースホルダー -->
                    <TextBlock Text="{DynamicResource FilterEmptyPlaceholderText}"
                               IsVisible="{Binding IsFilterEmpty}"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="{DynamicResource PlaceholderFontSize}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- ペイン区切りスプリッター -->
            <GridSplitter Grid.Column="1"
                          Width="{DynamicResource SplitterWidth}"
                          Background="{DynamicResource SplitterColor}"
                          ResizeDirection="Columns"/>

            <!-- 右ペイン：選択中トラックの詳細タグ表示・編集 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource DetailPaneBackgroundColor}">
                <Grid RowDefinitions="Auto,*">

                    <!-- 右ペイン上部ヘッダーバー（表示項目切替・独自タグ定義管理） -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ToolbarBackgroundColor}"
                            BorderBrush="{DynamicResource MainWindowBorderColor}"
                            BorderThickness="{DynamicResource BottomBorderThickness}"
                            Padding="{DynamicResource DetailPaneHeaderPadding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource DetailPaneHeaderTitleText}"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       FontSize="{DynamicResource LabelFontSize}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SmallItemSpacing}">
                                <Button Content="{DynamicResource DetailFieldsButtonText}"
                                        ToolTip.Tip="{DynamicResource DetailFieldsButtonToolTip}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        Padding="{DynamicResource CompactButtonPadding}"
                                        FontSize="{DynamicResource LabelFontSize}">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <ScrollViewer MaxHeight="{DynamicResource DetailFieldChooserFlyoutMaxHeight}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel MinWidth="{DynamicResource DetailFieldChooserFlyoutMinWidth}"
                                                            Margin="{DynamicResource ColumnChooserFlyoutPadding}"
                                                            Spacing="{DynamicResource ColumnChooserItemSpacing}">
                                                    <TextBlock Text="{DynamicResource DetailFieldChooserBasicTitleText}"
                                                               Foreground="{DynamicResource SectionHeaderColor}"
                                                               FontSize="{DynamicResource LabelFontSize}"
                                                               FontWeight="SemiBold"
                                                               Margin="{DynamicResource ColumnChooserHeaderMargin}"/>
                                                    <ItemsControl ItemsSource="{Binding DetailPane.Fields}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DetailPaneFieldOptionViewModel">
                                                                <CheckBox Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                          FontSize="{DynamicResource BodyFontSize}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="{DynamicResource ColumnChooserDividerHeight}"
                                                            Background="{DynamicResource MainWindowBorderColor}"
                                                            Margin="{DynamicResource ColumnChooserDividerMargin}"/>

                                                    <TextBlock Text="{DynamicResource DetailFieldChooserCustomTitleText}"
                                                               Foreground="{DynamicResource SectionHeaderColor}"
                                                               FontSize="{DynamicResource LabelFontSize}"
                                                               FontWeight="SemiBold"
                                                               Margin="{DynamicResource ColumnChooserHeaderMargin}"/>
                                                    <TextBlock Text="{DynamicResource DetailFieldChooserNoCustomText}"
                                                               IsVisible="{Binding !CustomTagCatalog.HasDefinitions}"
                                                               Foreground="{DynamicResource SecondaryTextColor}"
                                                               FontSize="{DynamicResource LabelFontSize}"/>
                                                    <ItemsControl ItemsSource="{Binding CustomTagCatalog.Definitions}"
                                                                  IsVisible="{Binding CustomTagCatalog.HasDefinitions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CustomTagDefinitionViewModel">
                                                                <CheckBox Content="{Binding FlyoutDisplayText}"
                                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                          FontSize="{DynamicResource BodyFontSize}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="{DynamicResource ColumnChooserDividerHeight}"
                                                            Background="{DynamicResource MainWindowBorderColor}"
                                                            Margin="{DynamicResource ColumnChooserDividerMargin}"/>

                                                    <Button Content="{DynamicResource ManageCustomTagsMenuButtonText}"
                                                            Command="{Binding OpenCustomTagManagerCommand}"
                                                            ToolTip.Tip="{DynamicResource ManageCustomTagsToolTip}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                            Padding="{DynamicResource CompactButtonPadding}"
                                                            FontSize="{DynamicResource LabelFontSize}"/>
                                                    <Button Content="{DynamicResource ResetDetailFieldsButtonText}"
                                                            Command="{Binding DetailPane.ResetFieldsCommand}"
                                                            ToolTip.Tip="{DynamicResource ResetDetailFieldsToolTip}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                            Padding="{DynamicResource CompactButtonPadding}"
                                                            FontSize="{DynamicResource LabelFontSize}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Content="{DynamicResource ManageCustomTagsMenuButtonText}"
                                        Command="{Binding OpenCustomTagManagerCommand}"
                                        ToolTip.Tip="{DynamicResource ManageCustomTagsToolTip}"
                                        MinHeight="{DynamicResource CompactButtonMinHeight}"
                                        Padding="{DynamicResource CompactButtonPadding}"
                                        FontSize="{DynamicResource LabelFontSize}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右ペイン本体 -->
                    <Grid Grid.Row="1">
                        <!-- 未選択時プレースホルダー -->
                        <TextBlock Text="{DynamicResource NoSelectionPlaceholderText}"
                                   IsVisible="{Binding !HasSelectedTrack}"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="{DynamicResource DetailPanePadding}"/>

                        <!-- 選択中トラック詳細（上部：バナー専用領域、下部：スクロール可能な詳細編集領域） -->
                        <Grid IsVisible="{Binding HasSelectedTrack}"
                              RowDefinitions="Auto,*">

                            <!-- 未保存状態バナー専用領域 -->
                            <Border Grid.Row="0"
                                    DataContext="{Binding SelectedTrack}"
                                    x:DataType="vm:TrackItemViewModel"
                                    Padding="{DynamicResource DetailBannerAreaPadding}"
                                    BorderBrush="{DynamicResource MainWindowBorderColor}"
                                    BorderThickness="{DynamicResource BottomBorderThickness}">
                                <Border Background="{DynamicResource DirtyBannerBackgroundColor}"
                                        BorderBrush="{DynamicResource DirtyBannerBorderColor}"
                                        BorderThickness="{DynamicResource ThinBorderThickness}"
                                        CornerRadius="{DynamicResource DefaultCornerRadius}"
                                        Padding="{DynamicResource DirtyBannerPadding}"
                                        Classes="dirty-banner"
                                        Classes.visible="{Binding IsDirty}"
                                        IsHitTestVisible="{Binding IsDirty}">
                                    <TextBlock Text="{DynamicResource UnsavedTrackBannerText}"
                                               Foreground="{DynamicResource DirtyIndicatorColor}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Border>

                            <!-- アートワーク・タグ・ファイル情報 -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="{DynamicResource DetailPanePadding}"
                                            DataContext="{Binding SelectedTrack}"
                                            x:DataType="vm:TrackItemViewModel">

                                    <!-- アートワーク表示・設定（D&D対応） -->
                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Artwork.IsVisible}"
                                                HorizontalAlignment="Stretch"
                                                Spacing="{DynamicResource DetailItemSpacing}">
                                        <Border IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).HasMultipleSelectedTracks}"
                                                Background="{DynamicResource SelectionBadgeBackgroundColor}"
                                                BorderBrush="{DynamicResource SelectionBadgeBorderColor}"
                                                BorderThickness="{DynamicResource ThinBorderThickness}"
                                                CornerRadius="{DynamicResource DefaultCornerRadius}"
                                                Padding="{DynamicResource SelectionBadgePadding}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ArtworkTargetSummaryText}"
                                                       Foreground="{DynamicResource SectionHeaderColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <Border Width="{DynamicResource ArtworkContainerSize}"
                                                Height="{DynamicResource ArtworkContainerSize}"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource CardBackgroundColor}"
                                                CornerRadius="{DynamicResource DefaultCornerRadius}"
                                                ClipToBounds="True"
                                                Classes="artwork-drop-target"
                                                DragDrop.AllowDrop="True"
                                                views:ArtworkDropBehavior.DropCommand="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DropArtworkCommand}">
                                            <Grid>
                                                <Image Source="{Binding ArtworkBitmap}"
                                                       Stretch="Uniform"
                                                       IsVisible="{Binding HasArtwork}"/>
                                                <TextBlock Text="{DynamicResource NoArtworkPlaceholderText}"
                                                           IsVisible="{Binding !HasArtwork}"
                                                           Foreground="{DynamicResource SecondaryTextColor}"
                                                           FontSize="{DynamicResource LabelFontSize}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Padding="{DynamicResource ArtworkHintPadding}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Border Classes="artwork-drop-overlay"
                                                        Background="{DynamicResource DropTargetOverlayBackgroundColor}"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ArtworkDropOverlayText}"
                                                               Foreground="{DynamicResource TextColor}"
                                                               FontSize="{DynamicResource BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Padding="{DynamicResource ArtworkHintPadding}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 複数アートワーク切替・並び順操作バー -->
                                        <Grid IsVisible="{Binding HasArtworkData}"
                                              ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="{DynamicResource SmallItemSpacing}"
                                                        VerticalAlignment="Center">
                                                <Button Content="{DynamicResource ArtworkPrevButtonText}"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectPreviousArtworkCommand}"
                                                        ToolTip.Tip="{DynamicResource ArtworkPrevToolTip}"
                                                        Width="{DynamicResource ArtworkNavButtonWidth}"
                                                        MinHeight="{DynamicResource ArtworkNavButtonMinHeight}"
                                                        Padding="{DynamicResource ArtworkNavButtonPadding}"
                                                        FontSize="{DynamicResource LabelFontSize}"
                                                        HorizontalContentAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedArtworkPositionText}"
                                                           Foreground="{DynamicResource TextColor}"
                                                           FontSize="{DynamicResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="{DynamicResource ArtworkNextButtonText}"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectNextArtworkCommand}"
                                                        ToolTip.Tip="{DynamicResource ArtworkNextToolTip}"
                                                        Width="{DynamicResource ArtworkNavButtonWidth}"
                                                        MinHeight="{DynamicResource ArtworkNavButtonMinHeight}"
                                                        Padding="{DynamicResource ArtworkNavButtonPadding}"
                                                        FontSize="{DynamicResource LabelFontSize}"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="{DynamicResource SmallItemSpacing}"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource ArtworkOrderLabelText}"
                                                           Foreground="{DynamicResource SecondaryTextColor}"
                                                           FontSize="{DynamicResource LabelFontSize}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="{DynamicResource ArtworkMoveLeftButtonText}"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).MoveArtworkLeftCommand}"
                                                        ToolTip.Tip="{DynamicResource ArtworkMoveLeftToolTip}"
                                                        Width="{DynamicResource ArtworkNavButtonWidth}"
                                                        MinHeight="{DynamicResource ArtworkNavButtonMinHeight}"
                                                        Padding="{DynamicResource ArtworkNavButtonPadding}"
                                                        FontSize="{DynamicResource LabelFontSize}"
                                                        HorizontalContentAlignment="Center"/>
                                                <Button Content="{DynamicResource ArtworkMoveRightButtonText}"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).MoveArtworkRightCommand}"
                                                        ToolTip.Tip="{DynamicResource ArtworkMoveRightToolTip}"
                                                        Width="{DynamicResource ArtworkNavButtonWidth}"
                                                        MinHeight="{DynamicResource ArtworkNavButtonMinHeight}"
                                                        Padding="{DynamicResource ArtworkNavButtonPadding}"
                                                        FontSize="{DynamicResource LabelFontSize}"
                                                        HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- サムネイル一覧（横スクロール） -->
                                        <ListBox IsVisible="{Binding HasArtworkData}"
                                                 Classes="artwork-thumbnails"
                                                 Height="{DynamicResource ArtworkThumbListHeight}"
                                                 ItemsSource="{Binding Artworks}"
                                                 SelectedItem="{Binding SelectedArtwork, Mode=TwoWay}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ArtworkItemViewModel">
                                                    <StackPanel Width="{DynamicResource ArtworkThumbItemWidth}"
                                                                Spacing="{DynamicResource ArtworkThumbContentSpacing}"
                                                                HorizontalAlignment="Center"
                                                                ToolTip.Tip="{Binding ThumbnailToolTipText}">
                                                        <Border Width="{DynamicResource ArtworkThumbImageSize}"
                                                                Height="{DynamicResource ArtworkThumbImageSize}"
                                                                Background="{DynamicResource ReadOnlyFieldBackgroundColor}"
                                                                CornerRadius="{DynamicResource DefaultCornerRadius}"
                                                                ClipToBounds="True"
                                                                HorizontalAlignment="Center">
                                                            <Image Source="{Binding PreviewBitmap}"
                                                                   Stretch="Uniform"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding ThumbnailLabel}"
                                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                                   FontSize="{DynamicResource SmallLabelFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="{Binding ArtworkInfoDisplay}"
                                                   Foreground="{DynamicResource SecondaryTextColor}"
                                                   FontSize="{DynamicResource LabelFontSize}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).MixedArtworkNoticeText}"
                                                   IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).HasMixedArtworkInSelection}"
                                                   Foreground="{DynamicResource PreviewWarningTextColor}"
                                                   FontSize="{DynamicResource LabelFontSize}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- アートワーク操作ボタン群 -->
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Center"
                                                   ItemSpacing="{DynamicResource SmallItemSpacing}"
                                                   LineSpacing="{DynamicResource SmallItemSpacing}">
                                            <Button Content="{DynamicResource AddArtworkButtonText}"
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AddArtworkCommand}"
                                                    ToolTip.Tip="{DynamicResource AddArtworkToolTip}"
                                                    Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                    FontSize="{DynamicResource LabelFontSize}"/>
                                            <Button Content="{DynamicResource ReplaceArtworkButtonText}"
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ReplaceArtworkCommand}"
                                                    ToolTip.Tip="{DynamicResource ReplaceArtworkToolTip}"
                                                    Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                    FontSize="{DynamicResource LabelFontSize}"/>
                                            <Button Content="{DynamicResource RemoveSelectedArtworkButtonText}"
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RemoveSelectedArtworkCommand}"
                                                    ToolTip.Tip="{DynamicResource RemoveSelectedArtworkToolTip}"
                                                    Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                    FontSize="{DynamicResource LabelFontSize}"/>
                                            <Button Content="{DynamicResource ClearAllArtworksButtonText}"
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ClearAllArtworksCommand}"
                                                    ToolTip.Tip="{DynamicResource ClearAllArtworksToolTip}"
                                                    Padding="{DynamicResource ArtworkActionButtonPadding}"
                                                    MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                    FontSize="{DynamicResource LabelFontSize}"/>
                                        </WrapPanel>

                                        <!-- 複数選択時：現在の構成を選択中すべてへ同期 -->
                                        <Button Content="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SyncArtworksButtonText}"
                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SyncArtworksToSelectionCommand}"
                                                ToolTip.Tip="{DynamicResource SyncArtworksToolTip}"
                                                IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).HasMultipleSelectedTracks}"
                                                Classes="sync-artwork-button"
                                                HorizontalAlignment="Center"/>

                                        <!-- 選択中アートワークの種別・説明編集 -->
                                        <StackPanel IsVisible="{Binding HasSelectedArtwork}"
                                                    Margin="{DynamicResource ArtworkMetadataMargin}"
                                                    Spacing="{DynamicResource SmallItemSpacing}">
                                            <StackPanel DataContext="{Binding SelectedArtwork}"
                                                        x:DataType="vm:ArtworkItemViewModel"
                                                        IsEnabled="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CanEditSingleTrackArtworkDetails}">
                                                <TextBlock Text="{DynamicResource ArtworkTypeLabelText}" Classes="field-label"/>
                                                <ComboBox ItemsSource="{Binding PictureTypeOptions}"
                                                          SelectedItem="{Binding SelectedPictureTypeOption, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          FontSize="{DynamicResource BodyFontSize}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ArtworkPictureTypeOption">
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBlock Text="{DynamicResource ArtworkDescriptionLabelText}" Classes="field-label"/>
                                                <TextBox Text="{Binding Description, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource ArtworkDescriptionPlaceholder}"
                                                         Classes="editable-field"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource ArtworkMultiSelectReadOnlyHintText}"
                                                       IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).HasMultipleSelectedTracks}"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       FontSize="{DynamicResource SmallLabelFontSize}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 基本タグ -->
                                    <TextBlock Text="基本タグ"
                                               Classes="section-header"
                                               IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.HasVisibleBasicTags}"/>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Title.IsVisible}">
                                        <TextBlock Text="タイトル" Classes="field-label"/>
                                        <TextBox Text="{Binding Title, Mode=TwoWay}" Classes="editable-field"/>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Artist.IsVisible}">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="{DynamicResource SmallItemSpacing}"
                                              Margin="{DynamicResource FieldLabelMargin}">
                                            <TextBlock Grid.Column="0"
                                                       Text="アーティスト"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ArtistMultiValueBadgeText}"
                                                       IsVisible="{Binding HasMultipleArtists}"
                                                       Foreground="{DynamicResource SectionHeaderColor}"
                                                       FontSize="{DynamicResource SmallLabelFontSize}"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ArtistMultiValueBadgeText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBox Text="{Binding Artist, Mode=TwoWay}" Classes="editable-field"/>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Album.IsVisible}">
                                        <TextBlock Text="アルバム" Classes="field-label"/>
                                        <TextBox Text="{Binding Album, Mode=TwoWay}" Classes="editable-field"/>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.AlbumArtist.IsVisible}">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="{DynamicResource SmallItemSpacing}"
                                              Margin="{DynamicResource FieldLabelMargin}">
                                            <TextBlock Grid.Column="0"
                                                       Text="アルバムアーティスト"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AlbumArtistMultiValueBadgeText}"
                                                       IsVisible="{Binding HasMultipleAlbumArtists}"
                                                       Foreground="{DynamicResource SectionHeaderColor}"
                                                       FontSize="{DynamicResource SmallLabelFontSize}"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding AlbumArtistMultiValueBadgeText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBox Text="{Binding AlbumArtist, Mode=TwoWay}" Classes="editable-field"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="{DynamicResource DetailItemSpacing}"
                                          IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.IsTrackOrDiscVisible}">
                                        <StackPanel Grid.Column="0"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Track.IsVisible}">
                                            <TextBlock Text="トラック (番号 / 総数)" Classes="field-label"/>
                                            <Grid ColumnDefinitions="*,Auto,*">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding TrackNumberText, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource CounterNumberPlaceholder}"
                                                         Classes="editable-field"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{DynamicResource CounterSeparatorText}"
                                                           Foreground="{DynamicResource SecondaryTextColor}"
                                                           Margin="{DynamicResource CounterSeparatorMargin}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding TrackCountText, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource CounterTotalPlaceholder}"
                                                         Classes="editable-field"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Disc.IsVisible}">
                                            <TextBlock Text="ディスク (番号 / 総数)" Classes="field-label"/>
                                            <Grid ColumnDefinitions="*,Auto,*">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding DiscNumberText, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource CounterNumberPlaceholder}"
                                                         Classes="editable-field"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{DynamicResource CounterSeparatorText}"
                                                           Foreground="{DynamicResource SecondaryTextColor}"
                                                           Margin="{DynamicResource CounterSeparatorMargin}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding DiscCountText, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource CounterTotalPlaceholder}"
                                                         Classes="editable-field"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,2*"
                                          ColumnSpacing="{DynamicResource DetailItemSpacing}"
                                          IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.IsYearOrGenreVisible}">
                                        <StackPanel Grid.Column="0"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Year.IsVisible}">
                                            <TextBlock Text="年" Classes="field-label"/>
                                            <TextBox Text="{Binding YearText, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource YearPlaceholder}"
                                                     Classes="editable-field"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Genre.IsVisible}">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="{DynamicResource SmallItemSpacing}"
                                                  Margin="{DynamicResource FieldLabelMargin}">
                                                <TextBlock Grid.Column="0"
                                                           Text="ジャンル"
                                                           Foreground="{DynamicResource SecondaryTextColor}"
                                                           FontSize="{DynamicResource LabelFontSize}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GenreMultiValueBadgeText}"
                                                           IsVisible="{Binding HasMultipleGenres}"
                                                           Foreground="{DynamicResource SectionHeaderColor}"
                                                           FontSize="{DynamicResource SmallLabelFontSize}"
                                                           HorizontalAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding GenreMultiValueBadgeText}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBox Text="{Binding Genre, Mode=TwoWay}" Classes="editable-field"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Comment.IsVisible}">
                                        <TextBlock Text="コメント" Classes="field-label"/>
                                        <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                                 Classes="editable-field"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="{DynamicResource CommentFieldMinHeight}"/>
                                    </StackPanel>

                                    <!-- 独自タグ (Vorbis Comment) -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource SectionMargin}">
                                        <TextBlock Grid.Column="0"
                                                   Text="独自タグ (Vorbis Comment)"
                                                   Foreground="{DynamicResource SectionHeaderColor}"
                                                   FontSize="{DynamicResource SectionHeaderFontSize}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource ManageCustomTagsButtonText}"
                                                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).OpenCustomTagManagerCommand}"
                                                ToolTip.Tip="{DynamicResource ManageCustomTagsToolTip}"
                                                Padding="{DynamicResource CompactButtonPadding}"
                                                MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                FontSize="{DynamicResource LabelFontSize}"/>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource NoVisibleDefinedCustomTagsPlaceholderText}"
                                               IsVisible="{Binding !#RootWindow.((vm:MainWindowViewModel)DataContext).CustomTagCatalog.HasVisibleDefinitions}"
                                               Foreground="{DynamicResource SecondaryTextColor}"
                                               FontSize="{DynamicResource LabelFontSize}"
                                               TextWrapping="Wrap"/>

                                    <!-- 定義済み独自タグ一覧（全トラック共通の入力欄） -->
                                    <ItemsControl ItemsSource="{Binding DefinedCustomTags}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomTagFieldViewModel">
                                                <StackPanel IsVisible="{Binding Definition.IsVisible}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Margin="{DynamicResource FieldLabelMargin}">
                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="{DynamicResource SmallItemSpacing}">
                                                            <TextBlock Text="{Binding Definition.DisplayLabel}"
                                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                                       FontSize="{DynamicResource LabelFontSize}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Definition.Key, StringFormat='({0})'}"
                                                                       IsVisible="{Binding Definition.HasCustomLabel}"
                                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                                       FontSize="{DynamicResource SmallLabelFontSize}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MultiValueBadgeText}"
                                                                   IsVisible="{Binding HasMultipleValues}"
                                                                   Foreground="{DynamicResource SectionHeaderColor}"
                                                                   FontSize="{DynamicResource SmallLabelFontSize}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                             PlaceholderText="{DynamicResource CustomTagValuePlaceholder}"
                                                             Classes="editable-field"
                                                             TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 未登録の独自タグ一覧（このトラックのみ存在する未定義キー） -->
                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.UnregisteredCustomTags.IsVisible}">
                                        <StackPanel IsVisible="{Binding HasUnregisteredCustomTags}">
                                            <TextBlock Text="{DynamicResource UnregisteredCustomTagsHeaderText}"
                                                       Foreground="{DynamicResource SecondaryTextColor}"
                                                       FontSize="{DynamicResource LabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       Margin="{DynamicResource SubSectionMargin}"/>

                                            <ItemsControl ItemsSource="{Binding UnregisteredCustomTags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CustomTagItemViewModel">
                                                        <Border Background="{DynamicResource CardBackgroundColor}"
                                                                BorderBrush="{DynamicResource MainWindowBorderColor}"
                                                                BorderThickness="{DynamicResource ThinBorderThickness}"
                                                                CornerRadius="{DynamicResource DefaultCornerRadius}"
                                                                Padding="{DynamicResource CustomTagCardPadding}"
                                                                Margin="{DynamicResource CustomTagCardMargin}">
                                                            <StackPanel Spacing="{DynamicResource SmallItemSpacing}">
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="{DynamicResource SmallItemSpacing}">
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding Key, Mode=OneWay}"
                                                                             Classes="readonly-field"
                                                                             Classes.error="{Binding HasKeyError}"/>
                                                                    <Button Grid.Column="1"
                                                                            Content="{DynamicResource RegisterCustomTagDefinitionButtonText}"
                                                                            Command="{Binding RegisterDefinitionCommand}"
                                                                            ToolTip.Tip="{DynamicResource RegisterCustomTagDefinitionToolTip}"
                                                                            MinHeight="{DynamicResource CompactButtonMinHeight}"
                                                                            Padding="{DynamicResource CompactButtonPadding}"
                                                                            FontSize="{DynamicResource LabelFontSize}"/>
                                                                    <Button Grid.Column="2"
                                                                            Content="{DynamicResource RemoveCustomTagButtonText}"
                                                                            Command="{Binding RemoveCommand}"
                                                                            ToolTip.Tip="{DynamicResource RemoveCustomTagToolTip}"
                                                                            Width="{DynamicResource RemoveTagButtonWidth}"
                                                                            Padding="{DynamicResource CompactButtonPadding}"
                                                                            HorizontalContentAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding KeyValidationError}"
                                                                           IsVisible="{Binding HasKeyError}"
                                                                           Foreground="{DynamicResource ErrorTextColor}"
                                                                           FontSize="{DynamicResource LabelFontSize}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                                         PlaceholderText="{DynamicResource CustomTagValuePlaceholder}"
                                                                         Classes="editable-field"
                                                                         TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ファイル・音声情報 -->
                                    <TextBlock Text="ファイル・音声情報"
                                               Classes="section-header"
                                               IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.HasVisibleFileInfo}"/>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.FileName.IsVisible}">
                                        <TextBlock Text="ファイル名" Classes="field-label"/>
                                        <TextBox Text="{Binding FileName, Mode=OneWay}"
                                                 Classes="readonly-field"
                                                 Classes.error="{Binding HasFileNameError}"/>
                                        <TextBlock Text="{Binding FileNameValidationError}"
                                                   IsVisible="{Binding HasFileNameError}"
                                                   Foreground="{DynamicResource ErrorTextColor}"
                                                   FontSize="{DynamicResource LabelFontSize}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.FilePath.IsVisible}">
                                        <TextBlock Text="フルパス" Classes="field-label"/>
                                        <TextBox Text="{Binding FilePath, Mode=OneWay}"
                                                 Classes="readonly-field"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="{DynamicResource DetailItemSpacing}"
                                          IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.IsDurationOrFileSizeVisible}">
                                        <StackPanel Grid.Column="0"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.Duration.IsVisible}">
                                            <TextBlock Text="再生時間" Classes="field-label"/>
                                            <TextBox Text="{Binding DurationDisplay, Mode=OneWay}" Classes="readonly-field"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.FileSize.IsVisible}">
                                            <TextBlock Text="ファイルサイズ" Classes="field-label"/>
                                            <TextBox Text="{Binding FileSizeDisplay, Mode=OneWay}" Classes="readonly-field"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel IsVisible="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DetailPane.AudioFormat.IsVisible}">
                                        <TextBlock Text="音声フォーマット" Classes="field-label"/>
                                        <TextBox Text="{Binding AudioSpecDisplay, Mode=OneWay}" Classes="readonly-field"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
